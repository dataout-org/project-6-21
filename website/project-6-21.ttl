    dataout:hasDefendant p621:individual_0028 ;
    dataout:hasPenalty p621:pen_detention_0f712906,
        p621:pen_expulsion_728d98ae ;
    dataout:hasSnippet "A Kyrgyzstan citizen was arrested for 24 hours and sentenced to an administrative expulsion for “promoting non-traditional sexual relations and/or preferences or sex change” via the internet.  The court did not specify the exact content that constituted the violation."@en ;
    dataout:hasTriggerObject p621:web_content_002 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
