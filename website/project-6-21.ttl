p621:record_49699afb a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_76025011,
        p621:source_eb730d53 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1237700761539 ;
    dataout:hasPenalty p621:pen_fine_2dd77035 ;
    dataout:hasSnippet "“MangaLib”, a platform for online comics and manga, was fined for publications on its website. The publication in this case is “Banana Fish” (Yoshida Akimi, 1985). From the court decision: “This material contains non-episodic depictions of non-traditional sexual relations between the protagonist Ash and other characters, represented by several illustrations of two males in a romantic context: kissing, hugging, and sensual touching.” The court stated that “the information displayed can be classified as revealing signs of a socio-cultural threat to the national security of the Russian Federation in terms of the protection of traditional values, since it reveals signs of ideological and psychological influence on the recipient in the form of the imposition of a destructive ideology (propaganda of non-traditional sexual relations).” This is one of at least 12 cases in a serial persecution of “MangaLib”. The manager of “MangaLib” was also prosecuted at least 12 times for different publications."@en,
        "“Мангалиб”, платформа онлайн-комиксов и манги, оштрафована за публикации на сайте. Публикация в этом деле – “Банановая рыба / Banana Fish” (Yoshida Akimi, 1985). Из постановления: “Материал содержит неэпизодическое изображение нетрадиционных сексуальных отношений между главным героем Эшем и другими персонажами, представленное несколькими иллюстрациями двух лиц мужского пола в романтическом контексте: поцелуи, объятия, чувственные прикосновения”. Суд заявил, что информация в этом комиксе “может быть квалифицирована как обнаруживающая признаки социокультурной угрозы национальной безопасности РФ в части, касающейся защиты традиционных ценностей, так как обнаруживает признаки идеологического и психологического воздействия на реципиента в виде насаждения деструктивной идеологии (пропаганды нетрадиционных сексуальных отношений).” Это одно из как минимум 12 дел против “Мангалиб”. Менеджер платформы также был оштрафован за различные публикации не менее 12 раз."@ru ;
    dataout:hasTriggerObject p621:comics_005 ;
    dataout:mentionedIn p621:mentioned_in_08881344,
        p621:mentioned_in_27517825,
        p621:mentioned_in_3abdf6e4,
        p621:mentioned_in_93fb0552 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0600/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_49699afb" .

p621:record_49a11bc6 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_b3c2b7c2 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:official_0033 ;
    dataout:hasPenalty p621:pen_fine_3bea0079 ;
    dataout:hasSnippet "The editor-in-chief of the TV channel “Fon Music” was fined for airing a music video 698 times, which “contained information demonstrating non-traditional sexual relations,” expressed in a scene of “kissing between two persons of the same biological sex (female)”. The exact video is unknown."@en ;
    dataout:hasTriggerObject p621:music_video_003 ;
