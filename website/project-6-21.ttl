p621:record_bdb81073 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_4bfc46d7 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:official_0032 ;
    dataout:hasPenalty p621:pen_fine_0d27af93 ;
    dataout:hasSnippet "The editor-in-chief of the TV channel “TOCHKA TV” was fined for airing the music video “Stranger” (2012) by Nikolai Baskov, labelled “16+”. The court stated that this video “contained information demonstrating non-traditional sexual relations and/or preferences” and should have had the label “18+”. According to the judicial expert analysis, the music video is a relationship story between two men placed in the “atmosphere of hedonism and debauchery, which is realised primarily through repeated scenes of non-verbal sensual interaction between two persons of the same biological sex (female) in a sexual context.”"@en ;
    dataout:hasTriggerObject p621:aH4080sT4P8 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-998/23" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_bdb81073" .

