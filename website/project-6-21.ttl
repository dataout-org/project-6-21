p621:record_93600a7c a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_0636e4dd ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0064 ;
    dataout:hasPenalty p621:pen_fine_c136ba7d ;
    dataout:hasSnippet "A VKontakte user was fined for publishing “an image of two naked men engaged in non-traditional sexual relations depicting same-sex intimacy.” The exact images are unclear; the profile has been deleted. This individual was fined at least three times by the same judge on the same day for posting on VKontakte and was also detained for 15 days for posting images depicting rainbow flags, which the court deemed as “public demonstration of extremist symbols” (article 20.3)."@en ;
