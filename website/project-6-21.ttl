p621:record_cdbbc2e8 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_08be087a,
        p621:source_6a040151 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1025202841399 ;
    dataout:hasPenalty p621:pen_fine_55bec9c0 ;
    dataout:hasSnippet "A small business company “Parol NN”, which sells books online, was fined for placing the book “Giovanni's Room” by James Baldwin on their website, because it contained “scenes of attractive sexual intimacy between same-sex individuals”, according to the court. Earlier, the decision of the same court that fined the company (400,000 RUB) for the same reason was cancelled by the higher instance. This case was also overruled by the higher instance, because there was a “violation of territorial jurisdiction”. The fine was cancelled."@en ;
    dataout:hasTriggerObject p621:OL35324964M ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-250/2024" ;
