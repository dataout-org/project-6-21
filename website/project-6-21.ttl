p621:record_7046d4eb a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_9532d85e ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1187746527099 ;
    dataout:hasPenalty p621:pen_fine_cffd8ebc ;
    dataout:hasSnippet "The company “M3”, which owns the streaming service “More.tv”, was fined for distributing the series “The Shannara Chronicles” (Alfred Gough, Miles Millar, 2016), labelled “16+”. The judicial experts identified six scenes, which “indirectly demonstrate non-traditional sexual relations and/or preferences.” The experts added that “along with the dialogues and general development of relationships between the women throughout the series, their interactions are perceived by the recipient as a demonstration of non-traditional sexual relationships and/or preferences.” The mentioned scenes were: 28:20-29:43 (E1S2), 23:46-25:25 (E2S2), 32:10-32:37 (E2S2), 16:34-16:42 (E4S2), 19:27-21:18 (E9S2), 34:53-35:15 (E10S2). Earlier, the product manager of this streaming service was fined for the same TV series (see case 5-1189/23)."@en ;
    dataout:hasTriggerObject p621:64122 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-190/2024" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_7046d4eb" .

p621:record_713fe4fd a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_29953e34 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_7 ;
    dataout:hasDefendant p621:individual_0027 ;
    dataout:hasPenalty p621:pen_expulsion_d1a4c0ca,
        p621:pen_fine_24bded26 ;
    dataout:hasSnippet "A German citizen was fined and ordered to leave the country for corresponding with a man on the gay dating app “Hornet”. The court found that the defendant's private messages “promoted non-traditional sexual attitudes, the attractiveness of non-traditional sexual relations, and a distorted idea of the social equivalence of traditional and non-traditional sexual relations”, and that the defendant “exerted ideological and psychological influence on [the message recipient], which led to the imposition of a system of ideas and values alien and destructive to Russian society.” The judge cited three messages the defendant sent to another “Hornet” user: “Being gay is allowed”; “It is simply sad that we have to separate people depending on what they do in bed… this should be a private matter”; “In the West, they are all so absorbed in themselves that they do not actually give their partner emotions and passion in bed.” The user with whom the defendant corresponded was a witness in this case, stating in his testimony that he responded to the defendant that “in Russia, LGBT is prohibited both morally and legally.”"@en ;
    dataout:hasTriggerObject p621:dating_profile_005 ;
    dataout:mentionedIn p621:mentioned_in_e9b8cd77 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-72/2023" ;
    schema:addressRegion region:41 ;
    schema:identifier "record_713fe4fd" .

p621:record_727f2846 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_26c97d7a ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0068 ;
    dataout:hasPenalty p621:pen_fine_8aa6a532 ;
    dataout:hasSnippet "An individual was prosecuted for posting a textual message on Telegram accompanied by “two images of 'rainbow' flags, similar to the symbols of the international LGBT social movement, which is classified as an extremist organisation”. The court stated that this content was “obviously aimed at forming non-traditional sexual attitudes, the attractiveness of non-traditional sexual relations and (or) preferences, and a distorted idea of the social equivalence of traditional and non-traditional sexual relations and (or) preferences.” The exact content is unknown."@en ;
    dataout:hasTriggerObject p621:social_media_119 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "16-5279/2025" ;
