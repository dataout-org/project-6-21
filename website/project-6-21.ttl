p621:record_b94ab3d4 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_9353e830 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0053 ;
    dataout:hasPenalty p621:pen_fine_07f58b42 ;
    dataout:hasSnippet "A Moscow resident was fined for a VKontakte video titled “Gay skinhead 88.” The ruling states that the video was publicly available and treated as unlawful solely because of its title and its association with “LGBT propaganda.” The judgment does not describe the video’s content in detail, nor explain whether the material was explicit, documentary, ironic, musical, or archival in character — only that police classified it as “promoting non-traditional relations” after discovering it during online monitoring. The same individual was fined at least twice for different online content. "@en ;
    dataout:hasTriggerObject p621:social_media_097 ;
    dataout:mentionedIn p621:mentioned_in_104b90c4,
        p621:mentioned_in_760fd5ae ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-719/25" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_b94ab3d4" .

p621:record_b9b95aa4 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_8e0e2021 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0026 ;
    dataout:hasPenalty p621:pen_fine_9b5845f3 ;
    dataout:hasSnippet "A VKontakte user was fined for posting an image “containing persons of the same sex (gender)”. According to the court, the image depicted the “signs of propaganda of non-traditional sexual relations, propaganda of norms of non-traditional sexual relations”. The defence argued that the image was art and depicted models. This individual was fined nine times by the same judge for posting images on VK."@en ;
    dataout:hasTriggerObject p621:social_media_030 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-312/2023" ;
    schema:addressRegion region:23 ;
