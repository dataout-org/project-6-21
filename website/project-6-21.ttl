p621:record_883fb9e0 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_035a4e28 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1057747513680 ;
    dataout:hasPenalty p621:pen_fine_23ec27f8 ;
    dataout:hasSnippet "The online streaming service “Tricolor Kino i TV Online” was fined for showing the film “Blow Dry” (2001, Paddy Breathnach) labelled “16+” with a 10-second scene (01:21:47-01:21:57) of “two same-sex characters (female) kissing in a sexual context”, which the court found to be the “demonstration of non-traditional sexual relationships to minors.”"@en ;
