p621:record_5d35e7e6 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_df0e6c2f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_4 ;
    dataout:hasDefendant p621:1067746062449 ;
    dataout:hasPenalty p621:pen_fine_b589b557 ;
    dataout:hasSnippet "The online marketplace “Wildberries” was fined for selling sex toys online, as well as other products containing references to “non-traditional sexual relations”, such as the books “Straight Talk About Homosexuality. The Other Side of Tolerance” (Richard Cohen, 2010) and “Violent Love” (Gerry Oster, 1991)."@en ;
