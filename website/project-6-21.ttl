p621:record_701a17bc a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_8eb5d54b,
        p621:source_9e7d797b ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1077758948112 ;
    dataout:hasPenalty p621:pen_fine_a1773a39 ;
    dataout:hasSnippet "The company that owns the streaming service “Ivi” was fined for the films “Little Italy” (Donald Petrie, 2018), “Dr. T & the Women” (Robert Altman, 2000), “Love Is Love Is Love” (Eleanor Coppola, 2021), and “Beginners” (Mike Mills, 2011), all labelled “16+”. The court found that these films “contained information demonstrating non-traditional sexual relations and/or preferences, which is prohibited for distribution among children.” It is not specified which scenes exactly constituted the violation."@en ;
