p621:record_6b264a42 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_09710dd0 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:individual_0003 ;
    dataout:hasPenalty p621:pen_fine_419b8f28 ;
    dataout:hasSnippet "The journalist Elena Klimova created the online support project “Children-404. LGBT-teenagers”, which included groups on social media, in which queer teens shared their experiences and sought support. The project regularly published their letters. The court determined that the project’s content constituted unlawful promotion of same-sex relationships among minors. In 2025, the European Court of Human Rights ruled that the decision of the Russian court violates the Articles 8 and 10 of the ECHR."@en ;
    dataout:hasTriggerObject p621:social_media_002 ;
    dataout:mentionedIn p621:mentioned_in_e5d01743,
        p621:mentioned_in_fde3f67d ;
    dataout:monitoredIncidentYear "2015"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-7/2015" ;
    schema:addressRegion region:66 ;
    schema:identifier "record_6b264a42" .

p621:record_6d20f1f4 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_16eac8fa ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0052 ;
    dataout:hasPenalty p621:pen_fine_c6b3e114 ;
    dataout:hasSnippet "An individual was fined for a TikTok video. According to the court, the video showed “a young man with long hair, headphones, glasses and a black T-shirt, accompanied by text placed on screen”. The exact text is unknown. The court held that the caption, together with the music, was sufficient to disseminate “propaganda of non-traditional sexual relations”. The same individual was prosecuted at least 7 times for different TikTok videos."@en ;
    dataout:hasTriggerObject p621:social_media_117 ;
    dataout:mentionedIn p621:mentioned_in_bc832cac ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-309/87/2025" ;
