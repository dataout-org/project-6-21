p621:record_bfd15862 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_b57ae365 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_7 ;
    dataout:hasDefendant p621:individual_0017 ;
    dataout:hasPenalty p621:pen_detention_c8d368aa,
        p621:pen_expulsion_41a9089b ;
    dataout:hasSnippet "A foreign national was detained and ordered to leave the country for posting a profile on the social media website “Drug Vokrug”. According to the court, the profile owner “being a male, posts photos of himself in a women's dress and a long-haired wig, and refers to himself in the feminine gender”, suggesting “intimate services for non-traditional relations”."@en ;
