p621:record_50ca2710 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_4a97a28f,
        p621:source_ea109a08 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1077759854919 ;
    dataout:hasPenalty p621:pen_fine_fb1fb954 ;
    dataout:hasSnippet "The streaming service “Kinopoisk” was fined for the series “Legacies” (Julie Plec, 2018). As the judicial experts explained, “non-traditional sexual relationships and preferences in the series are approved through the support and acceptance of such unions by the series’ characters, without condemning such relationships [...] the series is aimed at forming a positive attitude towards non-traditional sexual relationships and preferences, as well as their romanticisation through the use of artistic and psychological techniques and means.”"@en ;
    dataout:hasTriggerObject p621:79460 ;
    dataout:mentionedIn p621:mentioned_in_40b8e81e ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-4093/2024" ;
