p621:record_dcc5da08 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_f0478923 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:individual_0014 ;
    dataout:hasPenalty p621:pen_fine_f342b151 ;
    dataout:hasSnippet "Anastasia Panchenko, an activist and coordinator of Alexey Navalny's (a politician, Putin's ctitic) Krasnodar office, was fined for two Instagram photos of kissing couples that, according to the court, were “aimed at instilling non-traditional sexual attitudes in minors.” In one photo, a person is holding the banner “Love is stronger than fear”."@en ;
