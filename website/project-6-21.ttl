p621:record_74d48b6d a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_4f5ba87f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:individual_0055 ;
    dataout:hasPenalty p621:pen_fine_78ae80ff ;
    dataout:hasSnippet "While in prison, the individual was fined for \"promoting non-traditional sexual relations (homosexuality), which consisted of disseminating information among convicts about the social equivalence of traditional and non-traditional sexual relations.\" The court did not specify what information was disseminated."@en,
        "Будучи в заключении, физическое лицо было оштрафовано за “пропаганду нетрадиционных сексуальных отношений (гомосексуализм), что выразилось в распространении информации среди осужденных о социальной равноценности традиционных и нетрадиционных сексуальных отношений.” Суд не уточнил, какая именно информация была распространена."@ru ;
    dataout:hasTriggerObject p621:unclear_007 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-99/2025" ;
    schema:addressRegion region:27 ;
    schema:identifier "record_74d48b6d" .

p621:record_74de56cd a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_30a1e504 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:official_0027 ;
    dataout:hasPenalty p621:pen_fine_e4a63d9d ;
    dataout:hasSnippet "The deputy general director of the online streaming platform “Okko” was fined for distributing the film “Black Ghosts” (Andreas Marawell, 2015), labelled “16+”. The court mentioned the timecodes of four scenes, which “demonstrated non-traditional sexual relations and preferences” to minors: 00:11:10-00:12:57; 00:15:46-00:16:54; 01:33:41-01:35:07; 01:29:19-01:31:42. It is not specified what these scenes depicted."@en,
        "Заместитель генерального директора стриминговой платформы “Окко” была оштрафована за распространение фильма “Черные призраки” (Andreas Marawell, 2015) с маркировкой “16+”. Суд упомянул четыре тайм-кода сцен, “демонстрирующих нетрадиционные сексуальные отношения и (или) предпочтения” среди несовершеннолетних: 00:11:10-00:12:57; 00:15:46-00:16:54; 01:33:41-01:35:07; 01:29:19-01:31:42. В постановлении не уточняется, что именно было показано в этих сценах."@ru ;
    dataout:hasTriggerObject p621:487498 ;
    dataout:mentionedIn p621:mentioned_in_5ef49999 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-2433/2025-162" ;
    schema:addressRegion region:78 ;
    schema:identifier "record_74de56cd" .

p621:record_7582c90f a dataout:MonitoringRecord ;
