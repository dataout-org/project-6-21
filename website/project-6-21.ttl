p621:record_df60251a a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_7cd3d4bc ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1163926063938 ;
    dataout:hasPenalty p621:pen_fine_929c96b3 ;
    dataout:hasSnippet "The Kaliningrad regional organisation “KAUP” was prosecuted after authorities examined photographs from its June 2025 event “From Sunset to Sunrise.” The court deemed the photos from the festival “propaganda of non-traditional sexual relations and preferences” because they contained “BDSM paraphernalia, a 'BDSM' sign, kissing women, women in revealing outfits, and a woman exposing her breasts.” Evidence in the case included statements from Orthodox, Baptist, Muslim, and Buddhist organizations, which stated that “paraphernalia of the 'BDSM' psychosexual subculture pertains to non-traditional sexual relations and preferences, fosters non-traditional sexual attitudes, and [...] does not correspond to the traditional spiritual and moral values of the Russian Federation.”"@en,
        "Калининградская региональная общественная организация “Центр исторической реконструкции 'Кауп'” была привлечена к ответственности после того, как полицейские нашли фото с мероприятия “Вечеринка от заката до рассвета” на сайте организации в июне 2025. Суд счёл фото с фестиваля “пропагандой нетрадиционных сексуальных отношений и предпочтений”, поскольку на фото были “атрибутика БДСМ, вывеска 'BDSM', целующиеся девушки, девушки в откровенных нарядах, девушка, демонстрирующая грудь”. Среди доказательств в деле были письменные заключения православной, баптистской, мусульманской и буддийской организаций, которые заявили, что “атрибутика психосексуальной субкультуры 'БДСМ' относится к нетрадиционным сексуальным отношениям и предпочтениям, формирует нетрадиционные сексуальные установки и [...] не соответствует традиционным духовно-нравственным ценностям Российской Федерации.”"@ru ;
    dataout:hasTriggerObject p621:queer_venue_007 ;
    dataout:mentionedIn p621:mentioned_in_6f8c725f ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "12-136/2025 (5-29/2025)" ;
    schema:addressRegion region:39 ;
    schema:identifier "record_df60251a" .

p621:record_dfe1eec5 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_06de7a43 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_7 ;
    dataout:hasDefendant p621:individual_0090 ;
    dataout:hasPenalty p621:pen_detention_22398da3,
        p621:pen_expulsion_57d65218 ;
    dataout:hasSnippet "A Tajikistan citizen was detained for 10 days and ordered to leave the country for posts on Telegram, which, according to the court, were “aimed at developing non-traditional sexual attitudes.” The court stated that in these posts the defendant “offered intimate services, posing as a 'transsexual', a person who partially changed sex.” The exact content that constituted the violation is unknown."@en ;
    dataout:hasTriggerObject p621:social_media_063 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-91/2025" ;
    schema:addressRegion region:66 ;
