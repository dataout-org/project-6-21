p621:record_8b1ac68a a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_f021aa29 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_4 ;
    dataout:hasDefendant p621:official_0027 ;
    dataout:hasPenalty p621:pen_fine_cc192f57 ;
    dataout:hasSnippet "The deputy general director of the online streaming platform “Okko” was fined for distributing the film “Triggered” (2019, Christopher Moore). The judicial expertise established that “the genre, plot, and expressive means used [in the film] aimed at fostering a positive attitude toward non-traditional sexual relationships and/or preferences; The depicted same-sex relationships and the storyline are structured in such a way as to create a socio-psychological attitude not only toward the attractiveness of non-traditional sexual relationships and/or preferences, but also to foster a distorted perception of the social equivalence of traditional and non-traditional sexual relationships”. The streaming platform was also fined for the same film (see case 5-1661/2025)."@en ;
    dataout:hasTriggerObject p621:554100 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-1663/2025-162" ;
    schema:addressRegion region:78 ;
    schema:identifier "record_8b1ac68a" .

p621:record_8b566d88 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_5ffc9c02 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:1067746062449 ;
    dataout:hasPenalty p621:pen_fine_3288eda9 ;
    dataout:hasSnippet "The online marketplace “Wildberries” was fined for several items “promoting non-traditional sexual relationships”: “2018 Calendar. Erotica-2”, the book “First Orgasm in My Life. From the ‘Diary of a Latent Lesbian’ series” by Olga Serebryanskaya, “30x40 painting on canvas on a wooden stretcher”, and “Flag/Rainbow Flag/Non-traditional Flag 90x150”. The court concluded that these items were “aimed at developing non-traditional sexual attitudes in minors” because they were sold without age restriction."@en ;
    dataout:hasTriggerObject p621:book_001,
        p621:merch_001,
        p621:merch_002,
        p621:merch_003 ;
    dataout:monitoredIncidentYear "2022"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-315/22" ;
    schema:addressRegion region:89 ;
