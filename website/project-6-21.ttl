p621:record_cbb84503 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_26c7c7cd ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0041 ;
    dataout:hasPenalty p621:pen_fine_54723ccb ;
    dataout:hasSnippet "A VKontakte user was fined for publishing three videos, two of which were pornographic (“sex between a man and a MAN”), and another one depicted “kisses between a guy and a guy”, published in 2010. The court stated that these videos were “related to the promotion of non-traditional sexual relations of the LGBT community” and were of “an extremist nature”."@en,
        "Пользователь ВКонтакте был оштрафован за публикацию трёх видеороликов, два из которых были порнографическими (“секс между мужчиной и МУЖЧИНОЙ”), а ещё один, опубликованный в 2010, изображал “поцелуи между парнем и парнем”. Суд указал, что эти видеоролики “экстремистского содержания” и относятся к “пропаганде нетрадиционных сексуальных отношений ЛГБТ сообщества”."@ru ;
    dataout:hasTriggerObject p621:social_media_03146ab0,
        p621:social_media_058,
        p621:social_media_4cf47bb3 ;
    dataout:mentionedIn p621:mentioned_in_127f4456 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-3231/2024" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_cbb84503" .

p621:record_cbb910a8 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_ab1bb751 ;
