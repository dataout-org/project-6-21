    prov:wasDerivedFrom p621:source_84ef32a1,
        p621:source_b2756315 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:individual_0105 ;
    dataout:hasPenalty p621:pen_unknown_569134ca ;
    dataout:hasSnippet "An individual was prosecuted for “propaganda of non-traditional sexual relations and/or preferences, sex change” by wearing “women's clothing and a wig” in public. The residents of the village of Varfolomeevka (population around 1K) called the police after noticing this person on the street, as reported by the press office of the Ministry of Internal Affairs for Primorsky Krai. Other details of the case are unknown; the court did not publish the decision text."@en ;
    dataout:hasTriggerObject p621:public_action_001 ;
