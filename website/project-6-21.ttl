p621:record_3228cdf2 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_32360c37 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1077759854919 ;
    dataout:hasPenalty p621:pen_fine_784acc8d ;
    dataout:hasSnippet "The streaming service “Kinopoisk” was fined for the film “Yves Saint Laurent” (Jalil Lespert, 2014), which, according to the court, “contained information promoting non-traditional sexual relations and (or) preferences.” One judicial expert from Roskomnadzor, the Russian mass media regulator, stated that “scenes of non-traditional sexual relations are shown throughout the film, which meets the criteria of propaganda.” Another expert identified another “propaganda technique” in the film, which was “the formation of the image of a victim subjected to aggression from people of heterosexual orientation.”"@en ;
    dataout:hasTriggerObject p621:245775 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-2055/2024" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_3228cdf2" .

p621:record_337bf969 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_3456676f,
        p621:source_7fd21d42 ;
