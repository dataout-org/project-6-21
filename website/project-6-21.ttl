p621:record_4d9dc24e a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_864e08f9,
        p621:source_f1c74588 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1167746480208 ;
    dataout:hasPenalty p621:pen_fine_6926e9a9 ;
    dataout:hasSnippet "The company “DotDTechnology”, which owns the TV channel “Clubbing TV”, was fined for airing three music videos: “Flash” by Lewis OfMan (2018), “For Love” by filous feat. klei (2018), and “La Lueur” by Holism (2022). According to the court, these videos “demonstrated non-traditional sexual relationships and preferences to minors” because they were labelled “16+”. It is not specified what scenes exactly constituted the violation."@en ;
