p621:record_2c8f19ca a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_0b47d8d3 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0098 ;
    dataout:hasPenalty p621:pen_fine_0c5e01b5 ;
    dataout:hasSnippet "A VKontakte user was fined for “pictures of men dressed in women's clothing and accessories (children's hair clips)”. According to the judicial expertise, these pictures “contained psychological and linguistic signs of propaganda of non-traditional sexual relations (male homosexuality) and non-traditional sexual preferences (transvestism, transsexualism),” and that the author had “communicative goal to attract interest and form sexual attitudes, readiness for non-traditional sexual preferences and relationships.” The exact pictures are unknown. This individual was fined three times for publishing pictures on VK by the same judge on the same day."@en ;
    dataout:hasTriggerObject p621:social_media_071 ;
    dataout:mentionedIn p621:mentioned_in_06b5b7c3 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0297/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_2c8f19ca" .

