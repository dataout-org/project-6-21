p621:record_4ffe6e73 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_8b824431,
        p621:source_e35ba095 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:individual_0106 ;
    dataout:hasPenalty p621:pen_fine_f972a0a9 ;
    dataout:hasSnippet "Two women were fined for a video on social media, in which they “kissed in a cafe“, the mass media reported. According to the press office of the courts of Krasnodar Krai, the video depicted “indecent behaviour in a public place”. The court did not publish the court decision. See also case 5-55/2024."@en ;
    dataout:hasTriggerObject p621:social_media_037 ;
