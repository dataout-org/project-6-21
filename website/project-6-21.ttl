p621:record_28a5d9ba a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_2f686520,
        p621:source_5b48875d ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1217700348612 ;
    dataout:hasPenalty p621:pen_fine_c9e110f4 ;
    dataout:hasSnippet "The TV channel “START World” was fined for “demonstrating non-traditional sexual relations and/or preferences” by showing the film “Babysitting” (Philippe Lacheau, 2014), labelled “16+”. The judicial expertise identified two scenes in the film, which “depicted kisses between people of the same biological sex (female)”. According to the experts, “there was a sensual (non-conventional) kiss in the film, which is a demonstration of non-traditional sexual relations.”"@en ;
    dataout:hasTriggerObject p621:262551 ;
