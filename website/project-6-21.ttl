    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1047796736591 ;
    dataout:hasPenalty p621:pen_fine_0fec4b29 ;
    dataout:hasSnippet "The legal entity “FONBET TV”, which owns the music TV channel “TNT Music”, was fined for airing the music video “Summer Really Hurt Us” (2022) by ALMA, labelled “16+”. According to the court, the video contained “information depicting non-traditional sexual relationships and/or preferences that is prohibited for distribution to children.” The scene that violated the law was “an image of two individuals of the same biological sex (female) kissing.”"@en ;
    dataout:hasTriggerObject p621:X-58JhHUWQ4 ;
