    dataout:hasDefendant p621:individual_0093 ;
    dataout:hasPenalty p621:pen_fine_33930f5d ;
    dataout:hasSnippet "Two Instagram users were fined for posts “promoting non-traditional sexual relations with a twin brother.” The exact content that constituted the violation is unknown. See also case 05-707/1/2025."@en,
        "Два пользователя Инстаграма были оштрафованы за публикации “с пропагандой нетрадиционных сексуальных отношений с братом близнецом”. Неизвестно, какой иммено контент суд посчитал правонарушением. См. также дело 05-707/1/2025."@ru ;
    dataout:hasTriggerObject p621:social_media_100 ;
