    schema:identifier "record_6d20f1f4" .

p621:record_6e719509 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_358cff8f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0052 ;
    dataout:hasPenalty p621:pen_fine_f783ccbc ;
    dataout:hasSnippet "An individual was fined for a 7-second TikTok video. According to the court, the video showed “a young man with long hair, headphones, glasses and a black T-shirt, accompanied by text placed on screen”. The exact text is unknown. Police testified that the clip had already been deleted from TikTok by the time of the inspection, but had continued circulating on Telegram channels, where it was then examined and used as evidence. The same individual was prosecuted at least 7 times for different TikTok videos."@en ;
