p621:record_23a99716 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_19bea59d ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0070 ;
    dataout:hasPenalty p621:pen_fine_e19a9af5 ;
    dataout:hasSnippet "A VKontakte user was fined for posting four images and a video. The four images were memes depicting “men in women's wedding dresses with the text: Why should I ask you out? I was waiting for you to make the first move. Let's split the bill. Prove and show that you need me.” The video depicted “two women on a bed kissing naked.” As the court stated, these materials “promoted non-traditional sexual relations” because the images “showed the appearance of men, which [...] culturally in Russia does not correspond to the image of a man of traditional sexual orientation”, and the video demonstrated “acceptability of sexual interaction between members of the same biological sex.” The defendant appealed the decision, but the higher instance upheld it."@en,
        "Пользовательница ВКонтакте была оштрафована за публикацию четырёх изображений и одного видеоролика. Четыре изображения – это мемы с мужчинами в свадебных платьях и подписями: “Почему я должен приглашать на свидание?”, “Я ждал от тебя первого шага”, “Давай счет пополам”, “Докажи и покажи, что я нужен тебе”. На видео, согласно материалам дела, были изображены “две девушки на кровати целующиеся в обнаженном виде”. Суд пришёл к выводу, что этот контент “пропагандировал нетрадиционные сексуальные отношения”, поскольку изображения “показывают внешний вид мужчин, с существенными признаками образа, культурально в России не соответствующего образу мужчины традиционной половой ориентации”, а видео “допускает сексуальное взаимодействие между представителями одного биологического пола”. Постановление было обжаловано, но вышестоящая инстанция оставила его без изменения."@ru ;
    dataout:hasTriggerObject p621:social_media_074,
        p621:social_media_372da018,
        p621:social_media_57bc0ffa,
        p621:social_media_d1927c33,
        p621:social_media_e00046b3 ;
    dataout:mentionedIn p621:mentioned_in_63fbc417 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-48-80/2025" ;
