p621:record_941357af a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_2fe0c513 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:official_0022 ;
    dataout:hasPenalty p621:pen_fine_3f538d08 ;
    dataout:hasSnippet "The managing director of the streaming service “Kinopoisk” was fined for the film “Triggered” (Christopher Wesley Moore, 2019). The court stated that this film contains information “promoting non-traditional sexual relations”, as it features “footage of interaction between two characters of the same biological sex (male); Viewing these scenes creates an intimate and personal mood for subsequent intersexual relations; The fragments contain depictions of romantic relationships, including images of sexual intercourse, accompanied by music and dialogue, with humorous references to the characters' non-traditional sexual preferences”. The court also mentioned that the two main characters were portrayed as “positive with a range of positive qualities, such as kindness, understanding, and responsiveness. Relationships between characters of the same biological sex are presented in a romantic vein.”"@en ;
    dataout:hasTriggerObject p621:554100 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
