p621:record_b0e42e01 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_b7ad9235 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:1037706012376 ;
    dataout:hasPenalty p621:pen_fine_d9cb43e4 ;
    dataout:hasSnippet "The company “Gramota”, which owns the bookshop chain “Chitai gorod”, was fined for selling the graphic novel “Immortal” (“Bes/smertniy” by Koriandr, Eksmo, 2023). The court found that the book “had signs of promoting non-traditional sexual relations.” According to the judicial expertise carried out by the Crimean Engineering and Pedagogical University, the book “depicts psychological and physical (sexual) violence, with men serving as both subjects and objects (Koschei – Ivan; Prince – Koschei; Ivan – Sergei). Both the villain (Koschei) and the hero (Ivan) identify non-traditionally in terms of gender.” Among other pieces of evidence in this case was a police report submitted by the bookshop customer."@en ;
    dataout:hasTriggerObject p621:OL37892847W ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-444/2023" ;
    schema:addressRegion region:91 ;
    schema:identifier "record_b0e42e01" .

p621:record_b356a703 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_eb0b976f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:official_0006 ;
    dataout:hasPenalty p621:pen_fine_82c0f497 ;
    dataout:hasSnippet "The editor-in-chief of the online mass media “7×7 — Horizontal Russia” was fined for six publications from 2021. Based on the “psycho-linguistic” expert analysis, the court deemed the publications to be “promoting non-traditional sexual relationships”. It is unclear what exactly constituted the violation. The titles of the publications were redacted in the court decision. Based on the indicated time of the publications, we identified one of them, titled “‘This is some kind of cave-like savagery.’ An unidentified individual attacked LGBT activists with a spray can in the city centre of Yaroslavl” from 12.06.2021."@en ;
    dataout:hasTriggerObject p621:mass_media_006 ;
    dataout:monitoredIncidentYear "2022"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-2627/2022" ;
    schema:addressRegion region:11 ;
    schema:identifier "record_b356a703" .

