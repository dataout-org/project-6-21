    dataout:hasDefendant p621:individual_0085 ;
    dataout:hasPenalty p621:pen_detention_4b767090,
        p621:pen_expulsion_7f3450a1 ;
    dataout:hasSnippet "A Tajikistan citizen was detained for 15 days and ordered to leave the country for posting “an ad offering sexual services in a non-traditional form” on VKontakte. The court found the post to be promoting “non-traditional sexual relations” because it contained the text “Transsexual Sochi versatile big active [phone number]” supplemented by nude images, while indicating [the defendant's] male identity.”"@en ;
    dataout:hasTriggerObject p621:social_media_038 ;
