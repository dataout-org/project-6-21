    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0080 ;
    dataout:hasPenalty p621:pen_fine_ee68bbc4 ;
    dataout:hasSnippet "An individual was fined for posts on Telegram. The exact content that constituted the violation is not mentioned. The judge stated that “the dissemination of beliefs and preferences regarding sexual orientation and specific forms of sexual relations should not infringe on the dignity of others or call into question public morality as understood in Russian society.”"@en ;
    dataout:hasTriggerObject p621:social_media_106 ;
