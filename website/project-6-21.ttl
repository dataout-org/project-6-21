p621:record_fb65097d a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_39253c2e ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0020 ;
    dataout:hasPenalty p621:pen_fine_3570fbf7 ;
    dataout:hasSnippet "A VKontakte user was fined for posting the song “Love Me Everywhere” accompanied by the illustration of two men kissing. According to the judicial expertise, both the song and the illustration “promote non-traditional sexual relations.”"@en ;
    dataout:hasTriggerObject p621:social_media_021 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-248/23" ;
    schema:addressRegion region:91 ;
