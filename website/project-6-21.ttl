p621:record_2f27a2c6 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_9dc15f6f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1237700009700 ;
    dataout:hasPenalty p621:pen_fine_b068018a ;
    dataout:hasSnippet "The streaming service “Wink” was fined for distributing content that the court classified as propaganda of non-traditional sexual relations. The ruling stated that the platform had disseminated information “aimed at forming non-traditional sexual attitudes, creating the attractiveness of non-traditional sexual relations and preferences, and a distorted perception of the social equivalence of traditional and non-traditional sexual relations,” as well as imposing information capable of generating interest in such relations. The exact content that constituted the violation has been redacted in the court ruling."@en ;
    dataout:hasTriggerObject p621:unclear_005 ;
    dataout:mentionedIn p621:mentioned_in_3b8ab11e ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-2686/2024" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_2f27a2c6" .

p621:record_2f4ec4de a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_3fe32d28 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:official_0005 ;
    dataout:hasPenalty p621:pen_fine_b6881625 ;
    dataout:hasSnippet "The organiser of the “Spirit of Fire” film festival was fined for the textual description of the Russian film “Outlaw” (Ksenia Ratushnaya, 2020) on the festival website that read “A gay high school student and a young criminal are trying to win back the most popular guy in the school. An army general and a transgender dancer in 1985 put career and life on the line to be together.”"@en ;
    dataout:hasTriggerObject p621:577000 ;
