p621:record_f15f1fbd a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_d9cb528f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1167746480208 ;
    dataout:hasPenalty p621:pen_fine_7d00915d ;
    dataout:hasSnippet "The company “DotDTechnology”, which owns the TV channel “Clubbing TV”, was fined for distributing two music videos. The court found them to contain material “demonstrating non-traditional sexual relations”. The titles of the music videos have been redacted in the court ruling."@en ;
