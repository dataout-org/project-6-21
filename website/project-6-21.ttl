p621:record_5ce91e52 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_22b7e961,
        p621:source_a859de50 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1097746597046 ;
    dataout:hasPenalty p621:pen_fine_f312fab3 ;
    dataout:hasSnippet "The TV channel “TV-3” was fined for broadcasting “Piranha 3D” (2010, Alexandre Aja). The court found that the film contained scenes interpreted as “demonstrating non-traditional sexual relations” between women. In particular, the ruling referred to scenes involving “sensual interaction between two persons of the same biological sex (female),” including one woman licking salt from another woman’s body and “a prolonged kiss expressing sexual passion.” The editor-in-chief of this TV channel was also fined for the same film (see case 5-628/23)"@en ;
    dataout:hasTriggerObject p621:43593 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
