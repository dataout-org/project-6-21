p621:record_54d5262d a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_25003096,
        p621:source_501ec63a ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:1087746539210 ;
    dataout:hasPenalty p621:pen_fine_aab5a9dc ;
    dataout:hasSnippet "The publishing house “Ad Marginem” was fined for distributing six books: “More Happy Than Not” (Adam Silvera, 2015), “The Fruit of Knowledge” (Liv Strömquist, 2014), “The Miseducation of Cameron Post” (Emily Danforth, 2012), “Infernal Feminism” (Per Faxneld, 2022), “Fence, Vol. 2” (Pascat, 2018), and “Everybody: A Book About Freedom” (Olivia Lang, 2021). According to the court, these books “contained psychological and linguistic elements of propaganda for non-traditional sexual relations and/or preferences and/or sex change and also contained incitement to LGBTQ+ relationships”. The court mentioned that these books were sold at the “Falanster” bookshop, which was also fined for distributing the same titles (see case 05-0268/2025)."@en ;
    dataout:hasTriggerObject p621:9785444817810,
        p621:OL20004466W,
        p621:OL22355901W,
        p621:OL24826887M,
