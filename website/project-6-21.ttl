p621:record_23aeb376 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_a43d8c83 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0104 ;
    dataout:hasPenalty p621:pen_fine_8b8ee545 ;
    dataout:hasSnippet "An individual was fined for posting “a voiceover accompanied by video footage showing two women kissing” on Instagram. The judicial expert concluded that the content “presented same-sex female love in an attractive way (this is the type of relationship preferred by bloggers, fashionable and stylish-looking attractive modern women who live in stylish interiors);” and that it presented “non-traditional sexual relations (not between a man and a woman) [...] in an attractive manner.” The exact content that constituted the violation is unknown. The same individual was fined at least six times on the same day by the same judge for posting similar content on Telegram and Instagram."@en ;
    dataout:hasTriggerObject p621:social_media_088 ;
    dataout:mentionedIn p621:mentioned_in_e841c2de ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0439/222/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_23aeb376" .

p621:record_23db2edc a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_e0317208 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1137746363150 ;
    dataout:hasPenalty p621:pen_fine_64243235 ;
    dataout:hasSnippet "The legal entity “OMT”, which owns the TV channel “O2TV”, was fined for broadcasting the music video “Крылья” (“Wings”) by Dezery (2019). The court qualified the broadcast as propaganda, holding that the video promoted “the attractiveness of non-traditional sexual relations and preferences” and “a distorted perception of the social equivalence of traditional and non-traditional sexual relations.” Although the channel argued that the clip had been aired at night, marked 18+, and partially blurred, the court relied on expert conclusions stating that the music video still contained material “propagandising non-traditional sexual relations and (or) preferences,” and therefore treated the broadcast as unlawful media dissemination rather than mere age-classification error. The exact scenes in question are unclear."@en ;
    dataout:hasTriggerObject p621:mLJM9jLwo2c ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-7506/2023" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_23db2edc" .

p621:record_24cafe69 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_48856780,
        p621:source_e0da69a8 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0029 ;
    dataout:hasPenalty p621:pen_fine_f1b1e2aa ;
    dataout:hasSnippet "Beauty-blogger Igor Sinyak was fined after authorities concluded that content on his Telegram channel promoted non-traditional sexual relations online. The blogger successfully appealed this case in the higher instance, and the fine was cancelled. The case was overruled due to “violations committed by the police and the court of first instance”, as the media reported."@en ;
    dataout:hasTriggerObject p621:social_media_025 ;
