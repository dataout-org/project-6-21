p621:record_a3d077bb a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_73c6e243 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:individual_0004 ;
    dataout:hasPenalty p621:pen_fine_8c657d87 ;
    dataout:hasSnippet "An individual was fined for administering a social media group “Kids against homophobia” in VKontakte, where he posted such messages as “Love each other…”, “Love conquers all…”, and “It’s nicest to fall asleep hugging your loved one…”, attaching photos of two hugging teenagers, two sleeping teenagers, and two kissing teenagers. The court viewed these posts to be “portraying same-sex relationships as emotionally and aesthetically appealing to minors”."@en ;
    dataout:hasTriggerObject p621:social_media_001 ;
    dataout:monitoredIncidentYear "2015"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-1003/2015" ;
    schema:addressRegion region:63 ;
    schema:identifier "record_a3d077bb" .

p621:record_a3e244e5 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_e05c2ac6 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:individual_0002 ;
    dataout:hasPenalty p621:pen_fine_6ba9f2a2 ;
    dataout:hasSnippet "An activist was fined for his single protest, during which he displayed a banner with the text “Being gay and loving gays is normal, beating gays and killing gays is a crime”. The activist appealed his fine twice, but the Supreme Court of the Republic of Tatarstan still deemed the poster to promote non-traditional sexual relations."@en ;
    dataout:hasTriggerObject p621:protest_001 ;
