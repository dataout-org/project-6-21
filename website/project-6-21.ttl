p621:record_28983a47 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_5b45612c ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1237700009700 ;
    dataout:hasPenalty p621:pen_fine_635da878 ;
    dataout:hasSnippet "The company “Restrim Media” that owns the streaming service “Wink” was fined for three films: “Bridget Jones: The Edge of Reason” (Beeban Kidron, 2004), “Curse of Chucky” (Don Mancini, 2013), and “Blow Dry” (2001, Paddy Breathnach), all labelled “16+”. Roskomnadzor, the Russian mass media regulator, found the following scenes in these films to demonstrate “non-traditional sexual relations and/or preferences to minors”: in “Bridget Jones”, there were “two same-sex (female) characters kissing in a sexual context” (01:27:34-01:27:42); “Curse of Chucky” depicted “kisses of two women” (00:31:43-00:31:59, 00:35:27-00:36:13, 01:07:31-01:07:35) and “these same women planning to have virtual sex via video call” (00:46:42 00:47:25); “Blow Dry” showed “two same-sex (female) characters kissing in a sexual context” (01:21:47-01:21:57)."@en ;
    dataout:hasTriggerObject p621:167032,
