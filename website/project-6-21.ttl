    schema:identifier "record_4843a6c5" .

p621:record_484d6b44 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_a4ca698f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0076 ;
    dataout:hasPenalty p621:pen_fine_a9c16d23 ;
    dataout:hasSnippet "A VKontakte user was fined for “an image with the English-language text 'Some people are gay, get over it'”, which is a slogan of the Stonewall UK campaign from 2007. The image was published on VK in 2013. According to the court, this image “disseminated information aimed at developing non-traditional sexual attitudes in minors”. The exact image is unknown. The same individual was fined twice on the same day by the same judge for publishing images on VK (see also 05-0211/2025)."@en ;
    dataout:hasTriggerObject p621:social_media_083 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0212/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_484d6b44" .

p621:record_4895c117 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_66b699d7 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0047 ;
    dataout:hasPenalty p621:pen_fine_d28c55d0 ;
    dataout:hasSnippet "An individual was fined for an image on his Instagram page in the “tags” section, showing a “young woman together with him, as well as a large group of people holding a rainbow (pride) flag — a symbol associated with the LGBT community.” The exact content that constituted the violation is unknown."@en ;
    dataout:hasTriggerObject p621:social_media_036 ;
