p621:record_a126e0f7 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_dcae3ee4 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:individual_0069 ;
    dataout:hasPenalty p621:pen_fine_86de7058 ;
    dataout:hasSnippet "An individual was fined for “promoting non-traditional sexual relations” by wearing women's clothing while being on a tram. The court stated that “these actions deviate from generally accepted, established norms of behaviour in ordinary society and distort the perception of the social equivalence of traditional and non-traditional sexual relations, which also contributes to the emergence of interests in society and the formation of persistent stereotypes, including immoral ones.”"@en ;
