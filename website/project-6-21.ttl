p621:record_4bb4392a a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_cb1cdd05 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_4 ;
    dataout:hasDefendant p621:official_0036 ;
    dataout:hasPenalty p621:pen_fine_ef4e9cf5 ;
    dataout:hasSnippet "The editor-in-chief of the online media “Sports24” was fined for publishing the article titled “The three-time Olympic champion suddenly came out. She kept it a secret for over 12 years.” on the news aggregator website “Dzen”. The judicial experts from Roskomnadzor, the Russian mass media regulator, stated that the article was “aimed at forming a positive attitude towards non-traditional sexual relationships and preferences.” This individual was already fined by the same court for the same article published on the media's website (see case 5-672/2025)."@en,
        "Главный редактор сетевого издания “Спорт24” был оштрафован за публикацию статьи под названием “Трехкратная олимпийская чемпионка внезапно совершила каминг-аут. Она держала это в тайне больше 12 лет” на сайте-агрегаторе новостей “Дзен”. Судебные эксперты из Роскомнадзора заявили, что “транслируемые смыслы в материале направлены на формирование положительного отношения к нетрадиционным сексуальным отношениям и предпочтениям.” Это должностное лицо уже было оштрафовано тем же судом за ту же статью, опубликованную на сайте издания (см. дело 5-672/2025)."@ru ;
    dataout:hasTriggerObject p621:mass_media_008 ;
    dataout:mentionedIn p621:mentioned_in_1800fcaf ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-673/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_4bb4392a" .

p621:record_4c928da2 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_d8a291b7 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
