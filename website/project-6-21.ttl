p621:record_2664c888 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_c0b1303d ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0081 ;
    dataout:hasPenalty p621:pen_fine_bb91ff99 ;
    dataout:hasSnippet "A VKontakte user was fined for textual posts. According to the court, they contained “propaganda of non-traditional same-sex sexual relations.” The court did not specify the exact content. The amount of the fine has also been redacted from the court ruling."@en,
        "Пользовательница ВКонтакте была оштрафована за текстовые посты. По мнению суда, они содержали “пропаганду нетрадиционных однополых сексуальных отношений”. Суд не упомянул конкретный контент. Размер штрафа также был скрыт в постановлении."@ru ;
    dataout:hasTriggerObject p621:social_media_052 ;
