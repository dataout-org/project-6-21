p621:record_8bc2194c a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_ab20988c ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0065 ;
    dataout:hasPenalty p621:pen_fine_0ea8a4f2 ;
    dataout:hasSnippet "A VKontakte user was fined for publishing a photo, which, according to the court, “was promoting LGBT and non-traditional sexual orientation; it depicts a man participating in an LGBT parade, holding an LGBT flag.” The exact photo is unknown. The amount of the fine has been redacted from the court ruling. This individual was fined four times by the same judge on the same day for posting on VK."@en ;
