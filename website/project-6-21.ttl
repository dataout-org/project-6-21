p621:record_1da24f09 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_94211c23 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_4 ;
    dataout:hasDefendant p621:individual_0084 ;
    dataout:hasPenalty p621:pen_fine_945af8c1 ;
    dataout:hasSnippet "An individual was fined for posting “images promoting non-traditional sexual orientations among minors.” The exact content is unclear. Initially, a magistrate issued a 300,000 RUB fine to the defendant. The higher instance judge reduced the amount because of such mitigating circumstances as “disability since childhood, presence of mental illness confirmed by medical documents.” In his appeal, the defendant argued that he could not write or read, and the police officers took advantage of it when charging him."@en ;
    dataout:hasTriggerObject p621:web_content_003 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "12-341/2024" ;
    schema:addressRegion region:23 ;
    schema:identifier "record_1da24f09" .

p621:record_1f2ef8ef a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_d549a1ec ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:official_0019 ;
    dataout:hasPenalty p621:pen_fine_78c21f24 ;
    dataout:hasSnippet "The court fined the deputy general director for content on the streaming service “Ivi” for the film “Perfect Strangers” (Paolo Genovese, 2016). According to Roskomnadzor, the Russian mass media regulator, the film “demonstrated non-traditional sexual relations and/or preferences” among minors, because it was labelled “16+”. It is not specified which scenes exactly constituted the violation. The company which owns the streaming service was also fined for the same film (case 05-0771/2023)."@en ;
    dataout:hasTriggerObject p621:381341 ;
    dataout:mentionedIn p621:mentioned_in_f766fc33 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-1406/23" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_1f2ef8ef" .

p621:record_1fb16368 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_0daa8128,
        p621:source_da5c14d6 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1045402471157 ;
    dataout:hasPenalty p621:pen_fine_3f0abb21 ;
    dataout:hasSnippet "The legal entity “Inetra”, which owned the streaming service “Peers.TV”, was fined for “demonstration of materials containing LGBT scenes to minors”, according to mass media. The exact content that constituted the violation is unknown. An administrative protocol against the company was drawn up by Roskomnadzor, the Russian mass media regulator."@en ;
