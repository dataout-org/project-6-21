p621:record_4e0b6613 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_3053fdfe ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0064 ;
    dataout:hasPenalty p621:pen_fine_32eede55 ;
    dataout:hasSnippet "A VKontakte user was fined for publishing “an image of two men kissing with the text 'It could have been you and me, but you didn't go to PE'.” The judicial experts concluded that the image “contained linguistic and psychological signs of propaganda for non-traditional sexual relations [...] expressed in the presentation of love and sexual scenes between two men in an aesthetically pleasing manner with the aim of arousing interest in such contacts, i.e., in demonstrating and attracting the viewer's attention to non-traditional (same-sex) relationships.” The exact images are unclear; the profile has been deleted. This individual was fined at least three times by the same judge on the same day for posting on VKontakte and was also detained for 15 days for posting images depicting rainbow flags, which the court deemed as “public demonstration of extremist symbols” (article 20.3)."@en ;
    dataout:hasTriggerObject p621:social_media_114 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0761/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_4e0b6613" .

p621:record_4e165520 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_8de848d0,
        p621:source_aedcbd7e ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1077759854919 ;
    dataout:hasPenalty p621:pen_fine_c9d42497 ;
    dataout:hasSnippet "The streaming service “Kinopoisk” was fined for the film “Triggered” (Christopher Wesley Moore, 2019). As experts from Roskomnadzor, the Russian mass media regulator, concluded, the film “demonstrated information with the signs of a socio-cultural threat to the national security of the Russian Federation and [...] ideological and psychological influence on the recipient in the form of the imposition of a destructive ideology (propaganda of non-traditional sexual relations and (or) preferences).” The managing director of the streaming service was also fined for the same film (see case 5-647/2025)."@en ;
    dataout:hasTriggerObject p621:554100 ;
    dataout:mentionedIn p621:mentioned_in_3148344d ;
