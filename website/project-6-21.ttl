p621:record_f102a588 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_481f1dd3 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:official_0026 ;
    dataout:hasPenalty p621:pen_fine_6ba1a872 ;
    dataout:hasSnippet "The editor-in-chief of the TV channel “KINO TV” was fined for “distributing among minors” the film “V for Vendetta” (James McTeigue, 2006), labelled “16+”. According to Roskomnadzor, the Russian mass media regulator, this film demonstrated “non-traditional sexual relations and (or) preferences.” It is not specified what scenes exactly constituted the violation. The legal entity that owns the TV channel was also fined for the same film (see case 5-302/2024)."@en ;
