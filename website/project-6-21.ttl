p621:record_b60c20c2 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_72063bf0,
        p621:source_fc05da46 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:individual_0015 ;
    dataout:hasPenalty p621:pen_fine_520f9f14 ;
    dataout:hasSnippet "Journalist Yuri Dud was fined for his interview with an artist, Fedor Pavlov-Andreevich, who spoke about homophobia in Russia during the interview. The court found that this interview “with an open homosexualist and activist who emigrated from Russia” promoted “non-traditional sexual relations among minors.”"@en ;
