p621:record_205ff6a3 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_4c5a4a54 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1077759854919 ;
    dataout:hasPenalty p621:pen_fine_2fbe0a38 ;
    dataout:hasSnippet "The streaming service “Kinopoisk” was fined for distributing ten films: “Perfect Strangers” (Paolo Genovese, 2016), “Bridget Jones: The Edge of Reason” (Beeban Kidron, 2004), “Three Many Weddings” (Javier Ruiz Caldera, 2013), “Easy A” (Will Gluck, 2010), “Blow Dry” (Paddy Breathnach, 2001), “Compartment No. 6” (Juho Kuosmanen, 2021), “Greed” (Michael Winterbottom, 2019), “Green Book” (Peter Farrelly, 2018), “The Amusement Park” (the title translated from Russian, the exact film is unknown), and “Beanpole” (Kantemir Balagov, 2019). According to the court, these films “demonstrated non-traditional sexual relations and/or preferences to minors” and should have been marked “18+” instead of “16+”. The court did not specify the exact scenes in these movies that constituted the violation."@en ;
    dataout:hasTriggerObject p621:17203,
        p621:201765,
