p621:record_c2d72669 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_c2dc3900,
        p621:source_efda1be9 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1167847381130 ;
    dataout:hasPenalty p621:pen_fine_4041236c ;
    dataout:hasSnippet "The online streaming platform “Okko” was fined for the film “Abduction 101” (Steve Noir, Robin Entreinger, 2019), because it “contained a demonstration of non-traditional sexual relations and (or) preferences”, as the mass media reported. It is unknown what scenes exactly constituted the violation; the court did not publish the decision text. Earlier, the deputy general director of this streaming platform was also fined for the same film (see case 5-683/2025-162)."@en ;
    dataout:hasTriggerObject p621:612294 ;
    dataout:mentionedIn p621:mentioned_in_53eb8116 ;
