p621:record_cc4999b2 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_85cfbb23 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0095 ;
    dataout:hasPenalty p621:pen_fine_43f84c41 ;
    dataout:hasSnippet "A VKontakte user was fined for publishing a picture in 2016, which depicted “underage males kissing” with the caption “Like if you're tolerant of the younger generation”. As the judicial expert concluded, this image “contained psychological and linguistic signs of propaganda of non-traditional sexual relations (homosexualism), expressed in attracting interest and forming sexual attitudes towards non-traditional sexual relations.” The amount of the fine has been redacted from the court ruling. The same individual was fined by the same judge on the same day at least twice for pictures on VK (see also 5-0264/2025)."@en ;
    dataout:hasTriggerObject p621:social_media_069 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0265/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_cc4999b2" .

p621:record_cc596aa1 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_6f29ddd1 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:official_0031 ;
    dataout:hasPenalty p621:pen_fine_e7e030f7 ;
    dataout:hasSnippet "The project manager at “Mangalib”, a platform for online comics and manga, was prosecuted for several publications. The publication in this case is “Sex Life With My Beast Partner” (Komagome, 2018). The court stated that this “manga in the shojo genre contained a non-episodic depiction of non-traditional sexual relations between female characters with a beast-like creature (perceived as an animal) in a romantic and erotic context: hugs, kisses, sexually explicit actions, etc.” This individual was fined at least 12 times for different publications. The company “MangaLib” was also fined at least 12 times."@en,
        "Менеджер проектов “Мангалиб”, платформы онлайн-комиксов и манги, был привлечён к ответственности за несколько публикаций. Публикация в этом деле – “Зверь – партнер для Кодокури Сейкацу” (Komagome, 2018). Согласно суду эта “манга в жанре сёдзё” содержит “неэпизодическое изображение нетрадиционных сексуальных отношений между персонажами женского пола со звероподобным существом (воспринимается в качестве животного) в романтическом и эротическом контексте: объятия, поцелуи, сексуально откровенные действия и т.д.” Это должностное лицо было оштрафовано за различные публикации не менее 12 раз. ООО “Мангалиб” также была оштрафована не менее 12 раз."@ru ;
    dataout:hasTriggerObject p621:comics_008 ;
    dataout:mentionedIn p621:mentioned_in_27517825,
        p621:mentioned_in_7b4e742c ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0754/374/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_cc596aa1" .

p621:record_cc6462d8 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_2401b701 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1127847522110 ;
    dataout:hasPenalty p621:pen_fine_29955fe7 ;
    dataout:hasSnippet "The TV channel “KINO TV” was fined for “distributing among minors” the film “V for Vendetta” (James McTeigue, 2006), labelled “16+”. Roskomnadzor, the Russian mass media regulator, which carried out judicial expertise, found four scenes in the film “demonstrating non-traditional sexual relations.” Such scenes “expressed verbal (description) and visual components (images of kisses, hugs between persons of the same biological sex (female).” Earlier, the editor-in-chief of this TV channel was fined for the same film (see case 12-1609/2023)."@en ;
    dataout:hasTriggerObject p621:752 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-302/2024" ;
    schema:addressRegion region:78 ;
    schema:identifier "record_cc6462d8" .

p621:record_cc6d66f0 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_5e2e6379,
        p621:source_f6f63d36 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
