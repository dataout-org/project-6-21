p621:record_1d082d7d a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_c8c47cbc ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0089 ;
    dataout:hasPenalty p621:pen_warning_04aecf3a ;
    dataout:hasSnippet "A VKontakte user received a warning for publishing “anime-style images of males who are depicted kissing, as well as in the process of sexual intercourse, including in a perverted form.” The images were published between 2021 and 2024."@en,
        "Пользовательница ВКонтакте получила предупреждение за публикацию “изображений, нарисованных в стиле 'Аниме' лиц мужского пола, которые изображены целующимися, а также в процессе половых актов, в том числе в извращенной форме”. Изображения были опубликованы с 2021 по 2024 год."@ru ;
    dataout:hasTriggerObject p621:social_media_081 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0254/64/2025" ;
