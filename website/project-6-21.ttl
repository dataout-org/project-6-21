p621:record_da34f542 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_a0a1ac5f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0102 ;
    dataout:hasPenalty p621:pen_fine_580eedb9 ;
    dataout:hasSnippet "A Telegram user was fined after prosecutors identified a video featuring the defendant on a channel titled “ЦБ НЕ МИТ.” The ruling states only that the video contained “propaganda of non-traditional same-sex relations” and promoted their attractiveness, but provides no description of the content. The material came to official attention during a separate review of allegedly extremist content."@en,
        "Пользователь Телеграма был оштрафован за видео со своим участием опубликованом в канале под названием “ЦБ НЕ МИТ”. Сотрудники МВД нашли это видео во время проверки “экстремистских материалов” в интренете. Решение суда указывает только на то, что видео содержало “пропаганду нетрадиционных однополых сексуальных отношений”, но не предоставляет описание самого видео."@ru ;
    dataout:hasTriggerObject p621:social_media_062 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0100/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_da34f542" .

p621:record_da52ce2a a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_63ed3626,
        p621:source_76025011 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_4 ;
    dataout:hasDefendant p621:1237700761539 ;
    dataout:hasPenalty p621:pen_fine_39b58d47 ;
    dataout:hasSnippet "“MangaLib”, a platform for online comics and manga, was fined for publications on its website. The publication in this case is “Revolutionary Girl Utena: The Adolescence of Utena” (Be-Papas, 1999). According to the court's description, “the comic's main character [...] experienced a breakup with her lover, after which she decided to appear before people as a man. [...] The princess falls in love with [the main character] and doesn't hide her feelings: the girls kiss and spend time together.” The court stated that this comic “can be classified as a socio-cultural threat to the national security of the Russian Federation in terms of the protection of traditional values, since it reveals signs of ideological and psychological influence on the recipient in the form of the imposition of a destructive ideology (propaganda of non-traditional sexual relations)”. This is one of at least 12 cases in a serial persecution of “MangaLib”. The manager of “MangaLib” was also prosecuted at least 12 times for different publications."@en,
        "“Мангалиб”, платформа онлайн-комиксов и манги, оштрафована за публикации на сайте. Публикация в этом деле – “Девушка Революционерка Утена: Театральная версия” (Be-Papas, 1999). Из постановления: “Главная героиня комикса [...] пережила расставание с возлюбленным, после чего решила предстать перед людьми в мужском обличии. [...] Принцесса влюбляется в [главную героиню] и не скрывает своих чувств: девушки целуются и проводят время.” Суд заявил, что информация в этом комиксе “может быть квалифицирована как обнаруживающая признаки социокультурной угрозы национальной безопасности РФ в части, касающейся защиты традиционных ценностей, так как обнаруживает признаки идеологического и психологического воздействия на реципиента в виде насаждения деструктивной идеологии (пропаганды нетрадиционных сексуальных отношений).” Это одно из как минимум 12 дел против “Мангалиб”. Менеджер платформы также был оштрафован за различные публикации не менее 12 раз."@ru ;
    dataout:hasTriggerObject p621:comics_003 ;
    dataout:mentionedIn p621:mentioned_in_08881344,
        p621:mentioned_in_27517825,
        p621:mentioned_in_3abdf6e4,
        p621:mentioned_in_93fb0552 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0487/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_da52ce2a" .

