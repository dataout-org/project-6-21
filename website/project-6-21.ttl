p621:record_49e4ef4f a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_37657ddd,
        p621:source_a5f35b50 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1069847102346 ;
    dataout:hasPenalty p621:pen_fine_3ac49fb2 ;
    dataout:hasSnippet "A Saint Petersburg company was fined for online advertisements in VKontakte. One ad was about the nightclub “Born”, “aimed primarily at recreation for people of non-traditional sexual orientation”, according to the court case. Another ad mentioned the gay sauna “Near the Circus”. One piece of evidence in the case was a report to the police by a man who saw the club's advertisement online and decided to visit. As he stated, he saw some rooms in the club that “shocked” him."@en ;
    dataout:hasTriggerObject p621:queer_venue_002 ;
    dataout:mentionedIn p621:mentioned_in_2a9fba64 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-310/23" ;
    schema:addressRegion region:78 ;
    schema:identifier "record_49e4ef4f" .

p621:record_4a8cfdcd a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_359261d1 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:official_0031 ;
    dataout:hasPenalty p621:pen_fine_673b40fb ;
    dataout:hasSnippet "The project manager at “Mangalib”, a platform for online comics and manga, was prosecuted for several publications. The publication in this case is “Banana Fish” (Yoshida Akimi, 1985). The court stated that it “depicted romantic and/or sexual relationships between men”. This individual was fined at least 12 times for different publications. The company “MangaLib” was also fined at least 12 times."@en,
        "Менеджер проектов “Мангалиб”, платформы онлайн-комиксов и манги, был привлечён к ответственности за несколько публикаций. Публикация в этом деле – “Банановая рыба / Banana Fish” (Yoshida Akimi, 1985), в которой “изображаются романтические и/или сексуальные отношения между мужчинами”. Это должностное лицо было оштрафовано за различные публикации не менее 12 раз. ООО “Мангалиб” также была оштрафована не менее 12 раз."@ru ;
    dataout:hasTriggerObject p621:comics_005 ;
