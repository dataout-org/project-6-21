p621:record_2db8a5f6 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_3e97f89f,
        p621:source_77395d7e ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_1 ;
    dataout:hasDefendant p621:official_0038 ;
    dataout:hasPenalty p621:pen_fine_9c097bd7 ;
    dataout:hasSnippet "The director of the company “Kometa-Plus” was fined for distributing the board game “Forfeits”, which contained “elements promoting non-traditional sexual relations” among minors, as the mass media reported. The case was initiated after the organisation “Parental Committee of Stavropol” appealed to the prosecutor's office. The game asked the participants to roleplay different situations, such as “Pretend to be a same-sex couple on a date” and “Portray a man-loving Rambo” (text on the chips). The company that manufactured the board game was also fined (see case 7-149/2014)."@en,
        "Директор компании “Комета-Плюс” была оштрафована за распространение настольной игры “Фанты”, которая, как сообщали СМИ, содержала “элементы, пропагандирующие нетрадиционные сексуальные отношения” среди несовершеннолетних. Дело было возбуждено после обращения в прокуратуру организации “Родительский комитет Ставрополья”. Игра предлагала разыгрывать различные ситуации, такие как “Изобразите свидание однополой пары” или “Изобразите любящего мужчин Рэмбо” (текст на фишках). Компания-производитель настольной игры также была оштрафована (см. дело 7-149/2014)."@ru ;
    dataout:hasTriggerObject p621:merch_005 ;
    dataout:monitoredIncidentYear "2014"^^xsd:gYear ;
    dataout:monitoringRecordNumber "12-28/2014" ;
    schema:addressRegion region:67 ;
    schema:identifier "record_2db8a5f6" .

p621:record_2ec72a82 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_05c92cb6 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
