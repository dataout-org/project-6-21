p621:record_a1652f6a a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_2caef7aa ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1065902028620 ;
    dataout:hasPenalty p621:pen_fine_2bec6304 ;
    dataout:hasSnippet "The company “ER–Telecom Holding”, which owns the streaming service “Movix”, was fined for distributing the films “Perfect Strangers” (Paolo Genovese, 2016) and “Loud Connection” (Alexey Nuzhnyy, 2019), labelled “16+”. Experts from Roskomnadzor, the Russian mass media regulator, concluded that these films contained “violations on the LGBT theme with the demonstration of non-traditional sexual relations”, and that “the [films'] recipient's attention is directed to the fact of the existence of non-traditional sexual relations.” The court mentioned these scenes that consituted the violation from the first film: 00:58:46-00:59:09, 01:01:05-01:01:35, 01:01:36-01:03:50, 01:04:32-01:04:55, 01:05:56-01:06:35, 01:17:24-01:17:29, 01:17:40-01:20:40, 01:22:10-01:22:21. In the second film, such scenes were 01:02:59-01:04:53, 01:05:22-01:05:3, and 01:07:37-01:07:43. There are no details about what exactly experts found in these scenes."@en ;
    dataout:hasTriggerObject p621:381341,
        p621:570657 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-235/2023" ;
