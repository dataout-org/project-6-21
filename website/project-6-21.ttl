p621:record_c2d78d1d a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_c56cef39 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_4 ;
    dataout:hasDefendant p621:1167847381130 ;
    dataout:hasPenalty p621:pen_fine_7753cdd4 ;
    dataout:hasSnippet "The streaming platform “Okko” was held administratively liable for the film “Triggered” (2019, Christopher Moore). The judicial expertise established that “the genre, plot, and expressive means used [in the film] aimed at fostering a positive attitude toward non-traditional sexual relationships and/or preferences; The depicted same-sex relationships and the storyline are structured in such a way as to create a socio-psychological attitude not only toward the attractiveness of non-traditional sexual relationships and/or preferences, but also to foster a distorted perception of the social equivalence of traditional and non-traditional sexual relationships”. The deputy general director of the streaming platform was also fined for the same film (see case 5-1663/2025-162)."@en ;
    dataout:hasTriggerObject p621:554100 ;
    dataout:mentionedIn p621:mentioned_in_183c1120 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-1661/2025-162" ;
    schema:addressRegion region:78 ;
    schema:identifier "record_c2d78d1d" .

