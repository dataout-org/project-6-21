p621:record_c5abc646 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_c836c698 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0104 ;
    dataout:hasPenalty p621:pen_fine_07e6454f ;
    dataout:hasSnippet "An individual was fined for posting “a voice message, accompanied by a video recording, which depicts two women kissing” on Instagram. The judicial expert concluded that the content “presented same-sex female love in an attractive way (this is the type of relationship preferred by bloggers, fashionable and stylish-looking attractive modern women);” and that it presented “non-traditional sexual relations (not between a man and a woman) [...] in an attractive manner.” The exact content that constituted the violation is unknown. The court mentioned that the post had 18 comments and 211K views. The same individual was fined at least six times on the same day by the same judge for posting similar content on Telegram and Instagram."@en ;
    dataout:hasTriggerObject p621:social_media_092 ;
    dataout:mentionedIn p621:mentioned_in_e841c2de ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0437/222/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_c5abc646" .

