p621:record_d8a9e2d0 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_944a989a,
        p621:source_e43991cd ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1027739549221 ;
    dataout:hasPenalty p621:pen_fine_7e88b542 ;
    dataout:hasSnippet "The company “Channel One. Worldwide”, a subdivision of the state-controlled federal TV channel that owns another TV channel, “Dom Kino”, was fined for airing the film “B-Day!” (Roman Karimov, 2018), labelled “16+”. According to the court, the film “contained conflict-provoking scenes touching on the topic of non-traditional sexual relations and/or preferences and should have been labelled 18+.” The exact scenes that constituted the violation are not specified."@en ;
    dataout:hasTriggerObject p621:471970 ;
