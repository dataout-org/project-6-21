    dataout:hasSnippet "The company “Restrim Media” that owns the streaming service “Wink” was fined for “information demonstrating non-traditional sexual relations and/or preferences to minors.” The court redacted references to the exact content that constituted the violation."@en ;
    dataout:hasTriggerObject p621:unclear_006 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
