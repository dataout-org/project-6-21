    dataout:hasDefendant p621:official_0020 ;
    dataout:hasPenalty p621:pen_fine_733434bf ;
    dataout:hasSnippet "An official at the streaming service “Kinopoisk” was fined for distributing two films, “Breaking Up in Rome” (Edoardo Leo, 2021) and “Clouds of Sils Maria” (Olivier Assayas, 2014), labelled “16+”. Roskomnadzor, the Russian mass media regulator, found that these films contained “information and scenes demonstrating non-traditional sexual relations and/or preferences, where men kiss on the lips, as well as scenes with dialogue between characters that touch on the topic of non-traditional sexual relations and/or preferences, in particular homosexual relations.”"@en ;
    dataout:hasTriggerObject p621:246860,
        p621:666622 ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-957/23" ;
