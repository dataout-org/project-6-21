    dataout:hasDefendant p621:1237700009700 ;
    dataout:hasPenalty p621:pen_fine_b3700108 ;
    dataout:hasSnippet "The streaming service “Wink” was fined for distributing the South Korean TV series “The One and Only” (2021). The court found that the series, available with a 16+ rating, contained information “demonstrating non-traditional sexual relations and preferences through a recurring storyline involving emotional attachment between two women”. In court, an expert emphasised that the analysed material depicted “relations between persons of the same sex,” relying not only on dialogue but also on “the semantic load carried by dialogues and monologues,” as well as visual scenes where one heroine “places her hand on the hand of another under romantic music.” Screenshots shown to the court were said to depict the women “holding hands, preparing to kiss one another, and the negative reaction of one heroine’s mother who caught them at that moment,” leading the expert to conclude that the material conveyed “not heterosexual and not friendly relations between two persons of the same sex,” even though “sexual interaction itself was not presented.”"@en ;
    dataout:hasTriggerObject p621:127008 ;
    dataout:mentionedIn p621:mentioned_in_aff5451f ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "05-0770/2024" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_06378b0b" .

p621:record_066700be a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_0959ff84 ;
