p621:record_d1ed7fcb a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_d479115a ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0050 ;
    dataout:hasPenalty p621:pen_fine_36f267ec ;
    dataout:hasSnippet "An individual was fined for posting a meme on VKontakte, which depicted a drawing of Quentin Tarantino with a quote attributed to him, “Making movies and not children is my motto”. In court, the defendant explained that she had uploaded the image in 2021 because she liked Tarantino and, at that time, associated the quotation with prioritising work over family rather than rejecting parenthood. She also stated that she had lost access to the account in 2022 and could not delete the post. This ruling has been reported as the first known fine imposed under Russia’s ban on the so-called “childfree propaganda,” introduced by the November 2024 amendments to Article 6.21."@en ;
    dataout:hasTriggerObject p621:social_media_060 ;
    dataout:mentionedIn p621:mentioned_in_e13876c4 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0021/16/2025" ;
    schema:addressRegion region:92 ;
    schema:identifier "record_d1ed7fcb" .

