p621:record_f1332b9f a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_4d805313 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1077759854919 ;
    dataout:hasPenalty p621:pen_fine_133d88ab ;
    dataout:hasSnippet "The streaming service “Kinopoisk” was fined for distributing a series among minors, which, according to the court, contained scenes of “non-traditional sexual relations”. The court redacted the title of the series in the decision text. The judicial experts analysed the scene of the third episode of the series (48:52-49:05), which “contains a kiss between two individuals presented as persons of the same biological sex (female).” Their analysis was based on the “classification of kisses, which divides them into social and sensual, the latter differing depending on the types of feelings that lie behind the kissing signs (kisses of affection, kisses of tenderness, kisses of respect and kisses of love).” However, it is not specified how exactly the experts classified the kissing scene."@en ;
    dataout:hasTriggerObject p621:tv_series_001 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-2039/2024" ;
    schema:addressRegion region:77 ;
