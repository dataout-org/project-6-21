p621:record_d0202e0c a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_7df37337 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:1057747513680 ;
    dataout:hasPenalty p621:pen_fine_0a9e6406 ;
    dataout:hasSnippet "The online streaming service “Tricolor Kino i TV Online” was fined for the film “The Key Game” (Vicente Villanueva, 2022). Roskomnadzor, the Russian mass media regulator, carried out the judicial expertise of the film, analysing the characters, scenes, and dialogues. The experts concluded that “homosexual relationships are presented [in the film] not only as a common occurrence, but also as one of the possible ways to overcome a relationship crisis”, which served as proof of the “promotion of non-traditional sexual relations”."@en ;
    dataout:hasTriggerObject p621:901908 ;
