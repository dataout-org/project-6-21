p621:record_5494bd00 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_350e468e ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1167746480208 ;
    dataout:hasPenalty p621:pen_warning_9c50c967 ;
    dataout:hasSnippet "The company “DotDTechnology”, which owns the TV channel “Clubbing TV”, was issued a warning for airing six music videos: “Muchas” by Myd feat. Cola Boyy (2018), “Smile” by Galantis (2013), “Ride It” by Regard (2019), “La Lueur” by Holism (2022), “Hold Me To The Light” by KAS:ST (2021), and “You Boy” by Arigato Massaï feat. Yanis (2020). According to the court, these videos “demonstrated non-traditional sexual relationships and preferences to minors” because they were labelled “16+”. The judge decided to replace a fine with a warning because it was the company's first-time administrative offence. However, later, the company was fined by the same court for airing other music videos (see case 05-0475/2023)."@en ;
    dataout:hasTriggerObject p621:A-uU0hgRtQs,
        p621:jrRImnlJRrw,
