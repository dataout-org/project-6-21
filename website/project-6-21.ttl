p621:record_d4875644 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_4bcb821d ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0092 ;
    dataout:hasPenalty p621:pen_fine_4d3d18be ;
    dataout:hasSnippet "Two Instagram users were fined for posts “promoting non-traditional sexual relations with a twin brother.” The exact content that constituted the violation is unknown. See also case 05-706/1/2025."@en,
        "Два пользователя Инстаграма были оштрафованы за публикации “с пропагандой нетрадиционных сексуальных отношений с братом близнецом”. Неизвестно, какой иммено контент суд посчитал правонарушением. См. также дело 05-706/1/2025."@ru ;
