p621:record_641315d5 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_2bf5f66d,
        p621:source_70f34986 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:official_0021 ;
    dataout:hasPenalty p621:pen_fine_9e9dd57d ;
    dataout:hasSnippet "The “Yandex” CEO Artem Savinovsky was fined because the company's streaming service “Kinopoisk” showed such films as “Dr. T & the Women” (Robert Altman, 2000), “Little Italy” (Donald Petrie, 2018), “Alexander” (Oliver Stone, 2004), and “Love Is Love Is Love” (Eleanor Coppola, 2021) with the age restriction label “16+”. According to the court, these films “demonstrated non-traditional sexual relations and/or preferences” and should have been marked “18+”. The court did not specify the exact scenes in these movies that constituted the violation. "@en ;
