p621:record_96584e99 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_e03d89c6 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0098 ;
    dataout:hasPenalty p621:pen_fine_cd501827 ;
    dataout:hasSnippet "A VKontakte user was fined for a picture of “kissing men”. According to the judicial expertise, this picture “contained psychological and linguistic signs of propaganda of non-traditional sexual relations (male homosexuality) and non-traditional sexual preferences (transvestism, transsexualism),” and that the author had “communicative goal to attract interest and form sexual attitudes, readiness for non-traditional sexual preferences and relationships.” The exact picture is unknown. This individual was fined three times for publishing pictures on VK by the same judge on the same day."@en ;
    dataout:hasTriggerObject p621:social_media_072 ;
    dataout:mentionedIn p621:mentioned_in_06b5b7c3 ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0298/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_96584e99" .

p621:record_98f3e28b a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_830cd9cd ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:individual_0013 ;
    dataout:hasPenalty p621:pen_fine_6762fc28 ;
    dataout:hasSnippet "A VKontakte user was fined for posting “We invite you to sign up for Irkutsk LGBT Chat group. We're looking for active kids. Ages 14+ [...]”, which the court found to be “promotion of non-traditional sexual relations” among minors."@en ;
    dataout:hasTriggerObject p621:social_media_012 ;
