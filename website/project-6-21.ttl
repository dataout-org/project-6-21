p621:record_6679c2c9 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_34b621e5 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_2 ;
    dataout:hasDefendant p621:official_0002 ;
    dataout:hasPenalty p621:pen_fine_df5ceeee ;
    dataout:hasSnippet "The editor-in-chief of the local newspaper, “Young Far Easterner”, was fined for the article “History with Gayography.” This article tells a story of an openly gay school geography teacher in Khabarovsk who was fired because of his sexual orientation. The court found that this article “promoted non-traditional sexual relations among minors”."@en,
        "Главный редактор газеты “Молодой Дальневосточник” был оштрафован за статью “История с гейографией.” В этой статье рассказывается история открыто гомосексуального учителя географии в школе в Хабаровске, который был уволен из-за своей сексуальной ориентации. Суд установил, что эта статья “пропагандировала нетрадиционные сексуальные отношения среди несовершеннолетних”."@ru ;
    dataout:hasTriggerObject p621:mass_media_001 ;
    dataout:mentionedIn p621:mentioned_in_df9300cd ;
    dataout:monitoredIncidentYear "2014"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-28/2014" ;
    schema:addressRegion region:27 ;
    schema:identifier "record_6679c2c9" .

p621:record_6711ac2b a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_aca3469f ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0026 ;
    dataout:hasPenalty p621:pen_fine_f319bbe5 ;
    dataout:hasSnippet "A VKontakte user was fined for posting images “containing persons of the same sex (gender)”. According to the court, these images were the “signs of propaganda of non-traditional sexual relations, propaganda of norms of non-traditional sexual relations”. The defence argued that the images were screenshots of publicly available music videos and films. It is not specified which images exactly constituted the violation. This individual was fined nine times by the same judge for posting images on VK."@en ;
