p621:record_9d667ba0 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_6f8e4406 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0048 ;
    dataout:hasPenalty p621:pen_fine_995a1969 ;
    dataout:hasSnippet "An individual was fined for posting on his VKontakte profile. The authorities found an image in the “Saved photos” section, which “promoted non-traditional sexual relations” and “distorted representations of traditional relationships.” Images were deleted, and the exact content is unclear. The same individual was fined at least two times by the same judge on the same day for posting images."@en ;
    dataout:hasTriggerObject p621:social_media_047 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
