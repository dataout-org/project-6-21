    dataout:hasPenalty p621:pen_expulsion_3c6ba66f,
        p621:pen_fine_b43fe0fb ;
    dataout:hasSnippet "A foreign national was fined and ordered to leave the country for using social media to message with a minor in a way authorities interpreted as “promoting non-traditional sexual relationships”. The court decision did not specify which messages or actions constituted the violation."@en ;
