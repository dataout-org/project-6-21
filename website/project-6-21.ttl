p621:record_bbd0f805 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_d6948458 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0051 ;
    dataout:hasPenalty p621:pen_fine_6d2e2188 ;
    dataout:hasSnippet "A Moscow resident was fined after police monitoring identified two archived photographs on the defendant’s social media page, originally uploaded in 2017, depicting two naked women kissing and embracing. The court treated the images as unlawful because they remained publicly accessible in 2025 and concluded that their continued presence online constituted the dissemination of prohibited information. In addition to the photographs themselves, the ruling states that the page also displayed what authorities described as extremist symbolism — specifically “a flag consisting of six stripes”, characterised as the symbol of an organisation associated with “non-traditional sexual relations”, the dissemination of which is prohibited under anti-extremism legislation following the 2023 Supreme Court decision on the “international LGBT movement.”"@en,
        "Москвич был оштрафован после того, как полицейские нашли на его странице в социальной сети две фотографии, загруженные в 2017 году, на которых “изображен поцелуй двух однополых лиц (обнаженные девушки целуют друг друга в губы и обнимаются)”. Суд признал распространение изображений незаконным, поскольку в 2025 году они оставались в публичном доступе. В постановлении также указано, что на странице была размещена “экстремистская символика”, а именно “флаг, состоящий из шести полос”, связанный с “нетрадиционными сексуальными отношениями”, распространение которого запрещено после решения Верховного суда 2023 года по делу о “международном движении ЛГБТ”."@ru ;
    dataout:hasTriggerObject p621:social_media_095,
        p621:social_media_cb5ae0fe ;
    dataout:monitoredIncidentYear "2025"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-718/2025" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_bbd0f805" .

p621:record_bcdd50f4 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_0ee60fc4 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_7 ;
    dataout:hasDefendant p621:individual_0043 ;
    dataout:hasPenalty p621:pen_expulsion_db0f43e7,
        p621:pen_fine_1f794bf6 ;
    dataout:hasSnippet "An Uzbekistan citizen was fined and ordered to leave the country for posting “text messages about the provision of intimate services for non-traditional relationships” on VKontakte. The court stated that the messages “promoted non-traditional sexual relations and preferences” because their author “has a homosexual position ('vers', 'pass'), sexual orientation - gay,” and they were accompanied by “a nude photo of a man offering non-traditional sexual relations.”"@en ;
    dataout:hasTriggerObject p621:social_media_048 ;
    dataout:monitoredIncidentYear "2024"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-481/2024" ;
