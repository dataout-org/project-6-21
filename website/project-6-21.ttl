p621:record_c45ac685 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_591457fa,
        p621:source_afffe0fc ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_part_3 ;
    dataout:hasDefendant p621:individual_0034 ;
    dataout:hasPenalty p621:pen_fine_822f5a4b ;
    dataout:hasSnippet "Yan Dvorkin, head of the support centre for transgender and non-binary people, “Center-T”, was fined for a Telegram post announcing a marriage with such phrases as “So, gay marriages are here to stay!” and “Our insidious plan to legalise same-sex marriage was successful.” The court found Yan's post to be “promoting non-traditional sexual relationships” because the judicial expertise concluded that it presented relationships “not between a man and a woman” in a positive light and characterised such relationships as “natural”. The picture is a screenshot of the post mentioned in the court order."@en ;
    dataout:hasTriggerObject p621:social_media_017 ;
    dataout:mentionedIn p621:mentioned_in_949048ff ;
    dataout:monitoredIncidentYear "2023"^^xsd:gYear ;
    dataout:monitoringRecordNumber "5-0566/23" ;
    schema:addressRegion region:77 ;
    schema:identifier "record_c45ac685" .

