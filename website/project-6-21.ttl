p621:record_4675eea2 a dataout:MonitoringRecord ;
    prov:wasDerivedFrom p621:source_18089dc7,
        p621:source_a1173594 ;
    prov:wasGeneratedBy p621:MonitoringDec2025 ;
    dataout:concernsLegalArticle law:article_6_21_2_part_2 ;
    dataout:hasDefendant p621:1027700166636 ;
    dataout:hasPenalty p621:pen_fine_43ffcc88 ;
    dataout:hasSnippet "The company “VimpelCom”, which owns the streaming service “Beeline TV”, was fined for the film “Little Italy” (Donald Petrie, 2018), labelled “16+”. According to the court, the film “contains information demonstrating non-traditional sexual relations and/or preferences, which is prohibited for distribution among children, namely scenes demonstrating (describing) homosexual relations between men, as well as mentions of homosexual relations.” The description of the exact scenes was redacted in the court decision."@en ;
