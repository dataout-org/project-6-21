  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_eb32252e">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_0d918d42"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_3"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#individual_0104"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_3ddc37d4"/>
    <dataout:hasSnippet xml:lang="en">An individual was fined for posting “a voiceover accompanied by video footage showing two women kissing” on Instagram. The post is dated 14.02.2025. The judicial expert concluded that the content “presented same-sex female love in an attractive way (this is the type of relationship preferred by bloggers, fashionable and stylish-looking attractive modern women);” and that it presented “non-traditional sexual relations (not between a man and a woman) [...] in an attractive manner.” The exact content that constituted the violation is unknown. The same individual was fined at least six times on the same day by the same judge for posting similar content on Telegram and Instagram.</dataout:hasSnippet>
