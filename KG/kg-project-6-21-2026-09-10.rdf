    <dataout:concernsLegalArticle>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_4">
        <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Distributing information among minors demonstrating “non-traditional sexual relations and/or preferences”, including descriptions or depictions of such preferences, or information “capable of causing minors to desire to change their sex” by a foreign national or stateless person via mass media or internet. Does not apply to cases covered by part 8 of Article 6.21. Punishment: RUB 100K–200K fine with administrative expulsion from Russia, or detention for up to 15 days with subsequent expulsion.</schema:description>
        <schema:description xml:lang="ru">Распространение среди несовершеннолетних информации, демонстрирующей “нетрадиционные сексуальные отношения и (или) предпочтения”, включая их описание или изображение, либо информации, “способной вызвать у несовершеннолетних желание сменить пол” иностранным гражданином или лицом без гражданства через СМИ или интернет. Исключаются случаи, охватываемые частью 8 статьи 6.21. Наказание: штраф от 100 до 200 тыс. руб. с административным выдворением из России или арест до 15 суток с последующим выдворением.</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2"/>
        <schema:name xml:lang="en">Article 6.21.2 part 4</schema:name>
        <schema:name xml:lang="ru">Статья 6.21.2 часть 4</schema:name>
      </schema:Legislation>
    </dataout:concernsLegalArticle>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#individual_0035">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#individual"/>
