  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_ed66af93">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_26fd2212"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#1047796736591"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_e517afdb"/>
    <dataout:hasSnippet xml:lang="en">The legal entity “FONBET TV”, which owns the music TV channel “TNT Music”, was fined for airing the music video “Hallucination” by Regard and Years &amp; Years, labelled “16+”. According to the court, the music video “demonstrated non-traditional sexual relations and/or preferences” among minors. The experts from Roskomnadzor, the Russian mass media regulator, identified two scenes, in which gestures made by “persons of the male biological sex [...] encourage the recipient to perceive their dance as an expression of sexual interaction between persons of the same biological sex.” The editor-in-chief of this TV channel was also fined for the same content (see case 5-1072/23).</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#0rfBL_fCsI4"/>
