  <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_part_6">
    <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
    <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
    <schema:description xml:lang="en">Distributing information or carrying out public actions intended to promote “non-traditional sexual relations and/or preferences, sex change, or refusal to have children” among minors by a foreign national or stateless person. Punishment: RUB 100K–200K fine with administrative expulsion from Russia, or detention for up to 15 days with subsequent expulsion.</schema:description>
    <schema:description xml:lang="ru">Распространение информации или совершение публичных действий, направленных на “пропаганду нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения”, среди несовершеннолетних иностранным гражданином или лицом без гражданства. Наказание: штраф от 100 до 200 тыс. руб. с административным выдворением из России или арест до 15 суток с последующим выдворением.</schema:description>
    <schema:isPartOf>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21">
        <rdfs:comment xml:lang="en">The translation of the original title contains stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Оригинальное название статьи содержит уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Propaganda of non-traditional sexual relations and/or preferences, sex change, and refusal to have children</schema:description>
        <schema:description xml:lang="ru">Пропаганда нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#CAORF"/>
        <schema:name xml:lang="en">Article 6.21</schema:name>
        <schema:name xml:lang="ru">Статья 6.21</schema:name>
      </schema:Legislation>
    </schema:isPartOf>
    <schema:name xml:lang="en">Article 6.21 part 6</schema:name>
    <schema:name xml:lang="ru">Статья 6.21 часть 6</schema:name>
  </schema:Legislation>
