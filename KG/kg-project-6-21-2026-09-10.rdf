  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_de0d66cb">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_c512543b"/>
