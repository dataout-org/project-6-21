    <dataout:concernsLegalArticle>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_part_1">
        <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Distributing information or carrying out public actions intended to promote “non-traditional sexual relations and/or preferences, sex change, or refusal to have children”. Individuals may be fined RUB 50K–100K; officials RUB 100K–200K; and legal entities RUB 800K–1M, or have their activities suspended for up to 90 days.</schema:description>
        <schema:description xml:lang="ru">Распространение информации или совершение публичных действий, направленных на “пропаганду нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения”. Наказание: штраф от 50 до 100 тыс. руб. для физических лиц, для должностных — от 100 до 200 тыс. руб., для юридических — от 800 тыс. до 1 млн. руб. или административное приостановление деятельности до 90 суток.</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21"/>
        <schema:name xml:lang="en">Article 6.21 part 1</schema:name>
        <schema:name xml:lang="ru">Статья 6.21 часть 1</schema:name>
      </schema:Legislation>
    </dataout:concernsLegalArticle>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#1087746888833">
        <rdf:type rdf:resource="https://schema.org/Organization"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#legalEntity"/>
        <schema:identifier>1087746888833</schema:identifier>
        <schema:legalName xml:lang="ru">ООО “Фаланстер”</schema:legalName>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_e44f8572">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b240">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">The bookshop “Falanster” was fined for selling six books: “More Happy Than Not” (Adam Silvera, 2015), “The Fruit of Knowledge” (Liv Strömquist, 2014), “The Miseducation of Cameron Post” (Emily Danforth, 2012), “Infernal Feminism” (Per Faxneld, 2022), “Fence, Vol. 2” (C. S. Pacat, 2019), and “Everybody: A Book About Freedom” (Olivia Lang, 2021). The judicial expertise established that these books “contain psychological and linguistic signs of propaganda for non-traditional sexual relations and/or preferences and/or gender reassignment, and also contain incitement to involvement in LGBT relationships.” The general director of the bookshop was also fined by the same judge on the same day for distributing the same books (see case 05-0269/2025).</dataout:hasSnippet>
