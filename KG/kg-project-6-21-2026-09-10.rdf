  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_885a7488">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_608be1aa">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#16RS0046"/>
        <dataout:courtDocumentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-04-06</dataout:courtDocumentDate>
        <dataout:courtDocumentNumber>5-480/2023</dataout:courtDocumentNumber>
        <dataout:sourceCategory rdf:resource="https://dataout.org/ontology#courtDocument"/>
        <dataout:uniqueCourtDocumentID>16RS0046-01-2023-003778-07</dataout:uniqueCourtDocumentID>
      </dataout:Source>
