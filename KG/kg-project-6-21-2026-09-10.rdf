        <schema:name xml:lang="ru">Генеральный директор ООО "Рестрим Медиа"</schema:name>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_a469721f">
