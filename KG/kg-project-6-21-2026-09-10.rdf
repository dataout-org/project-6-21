    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_376b8d92">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b73">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">The company “VimpelCom”, which owns the streaming service “Beeline TV”, was fined for three films: “Perfect Strangers” (Paolo Genovese, 2016), “Blow Dry” (Paddy Breathnach, 2001), and “Easy A” (Will Gluck, 2010), all labelled “16+”. According to the judicial expertise, in “Perfect Strangers”, there are “scenes demonstrating (describing) homosexual relations between men, as well as mentions of homosexual relations”, although the exact scenes are not specified. In “Blow Dry”, the experts found the scene with the time code 01:21:45-01:22:01, in which “two characters of the same sex (female) are depicted kissing in a sexual context.” In “Easy A”, the scene 01:23:17-01:23:33 “depicted non-traditional sexual relations (of men), as well as multiple references to a representative of non-traditional sexual orientation.”</dataout:hasSnippet>
