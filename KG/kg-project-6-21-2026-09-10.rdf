  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_f7f20549">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_26982a73">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77MS0411"/>
