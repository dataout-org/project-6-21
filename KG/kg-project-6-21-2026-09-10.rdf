  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_4a8cfdcd">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_359261d1">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77MS0374"/>
