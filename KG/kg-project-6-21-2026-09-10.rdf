  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_599a93d6">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_688f2479"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#1077758948112"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_dd1b9018"/>
    <dataout:hasSnippet xml:lang="en">The streaming platform “IVI” was fined for distributing the South Korean TV series “The One and Only” (2021). The court held that the series contained scenes “demonstrating non-traditional sexual relations through the backstory of two female characters whose past romantic attachment is gradually revealed through memory scenes, dialogue, and visual detail”. According to the ruling, prohibited content included scenes in which one woman “gently strokes the hand” of another, memories of how the two women once planned “to leave together for one of the European countries so that they could avoid hiding their relationship from others,” and a later confrontation in which one character openly states: “We loved each other.” The court further stressed that “the totality of all the above-listed scenes … helps the recipient create a picture of non-traditional sexual relations,” and concluded that, given “the systemic thinking of the recipient,” these fragments constituted prohibited demonstration of same-sex relations.</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#127008"/>
    <dataout:monitoredIncidentYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dataout:monitoredIncidentYear>
    <dataout:monitoringRecordNumber>05-0796/2024</dataout:monitoringRecordNumber>
    <schema:addressRegion rdf:resource="https://dataout.org/rdf/reference/ru_regions#77"/>
    <schema:identifier>record_599a93d6</schema:identifier>
  </dataout:MonitoringRecord>
  <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#mentioned_in_76d8b7af">
    <dcterms:creator xml:lang="en">BBC</dcterms:creator>
    <dcterms:creator xml:lang="ru">BBC</dcterms:creator>
    <dcterms:language>ru</dcterms:language>
    <dataout:sourceCategory rdf:resource="https://dataout.org/ontology#massMediaPublication"/>
    <schema:archivedAt rdf:resource="https://web.archive.org/web/20210622120212/https://www.bbc.com/russian/russia/2013/07/130731_kazan_lgbt_work_case"/>
    <schema:url rdf:resource="https://www.bbc.com/russian/russia/2013/07/130731_kazan_lgbt_work_case"/>
  </dataout:Source>
  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_e45b5392">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_f27da929"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#official_0025">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#official"/>
        <schema:affiliation rdf:resource="https://dataout.org/rdf/data/project-6-21#1097746597046"/>
        <schema:identifier>official_0025</schema:identifier>
        <schema:name xml:lang="en">Editor-in-chief of the TV channel “TV-3 Russia”</schema:name>
        <schema:name xml:lang="ru">Главный редактор телеканала “ТВ-3 Россия”</schema:name>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_645feddd"/>
    <dataout:hasSnippet xml:lang="en">The editor-in-chief of the TV channel “TV-3 Russia” was fined for airing the film “Piranha 3D” (Alexandre Aja, 2010) twice with the label “16+”. Roskomnadzor, the Russian mass media regulator, identified two scenes in the film “demonstrating non-traditional sexual relations” among minors: “a girl licking salt off another girl’s body and a prolonged kiss expressing sexual passion (timestamps 00:51:10–00:51:28 and 00:55:21–00:55:39).”</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#43593"/>
    <dataout:monitoredIncidentYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</dataout:monitoredIncidentYear>
    <dataout:monitoringRecordNumber>5-628/23</dataout:monitoringRecordNumber>
    <schema:addressRegion rdf:resource="https://dataout.org/rdf/reference/ru_regions#77"/>
    <schema:identifier>record_e45b5392</schema:identifier>
  </dataout:MonitoringRecord>
  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_6d20f1f4">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_16eac8fa"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_3"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#individual_0052"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_c6b3e114"/>
    <dataout:hasSnippet xml:lang="en">An individual was fined for a TikTok video. According to the court, the video showed “a young man with long hair, headphones, glasses and a black T-shirt, accompanied by text placed on screen”. The exact text is unknown. The court held that the caption, together with the music, was sufficient to disseminate “propaganda of non-traditional sexual relations”. The same individual was prosecuted at least 7 times for different TikTok videos.</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#social_media_117"/>
    <dataout:mentionedIn rdf:resource="https://dataout.org/rdf/data/project-6-21#mentioned_in_bc832cac"/>
