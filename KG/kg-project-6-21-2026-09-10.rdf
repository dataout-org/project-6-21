  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_d845c31c">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_8dcbc44d">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77RS0017"/>
        <dataout:courtDocumentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-04</dataout:courtDocumentDate>
        <dataout:courtDocumentNumber>05-0627/2025</dataout:courtDocumentNumber>
        <dataout:sourceCategory rdf:resource="https://dataout.org/ontology#courtDocument"/>
        <dataout:uniqueCourtDocumentID>77RS0017-02-2025-014907-79</dataout:uniqueCourtDocumentID>
      </dataout:Source>
    </prov:wasDerivedFrom>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_part_3">
        <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Distributing information or carrying out public actions intended to promote “non-traditional sexual relations and/or preferences, sex change, or refusal to have children” via mass media or internet. Individuals may be fined RUB 100K–200K; officials RUB 200K–400K; and legal entities RUB 1M–4M, or have their activities suspended for up to 90 days.</schema:description>
        <schema:description xml:lang="ru">Распространение информации или совершение публичных действий, направленных на “пропаганду нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения” через СМИ или интернет. Наказание: штраф от 100 до 200 тыс. руб. для физических лиц, для должностных — от 200 до 400 тыс. руб., для юридических — от 1 до 4 млн. руб. или административное приостановление деятельности до 90 суток.</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21"/>
        <schema:name xml:lang="en">Article 6.21 part 3</schema:name>
        <schema:name xml:lang="ru">Статья 6.21 часть 3</schema:name>
      </schema:Legislation>
    </dataout:concernsLegalArticle>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#individual_0065">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#individual"/>
        <schema:identifier>individual_0065</schema:identifier>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_793fb510">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">A VKontakte user was fined for publishing an image, which the court described as “depicting four situations, where in the first there is a seated person looking at a monitor and reading 'straight gay', in the last part, there is an LGBT flag.” According to the court, this image “was aimed at promoting LGBT and non-traditional sexual orientation.” The exact image is unknown. The amount of the fine has been redacted from the court ruling. This individual was fined four times by the same judge on the same day for posting on VK.</dataout:hasSnippet>
