  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_83c3f5b7">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_da803add"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_4"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#individual_0082"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_6380dc99"/>
    <dataout:hasSnippet xml:lang="en">An individual was fined for a profile on a website, which “advertised sex services”. According to the court, the textual and visual information in the profile is “unambiguously aimed at popularizing and promoting non-traditional sexual relations, including among minors, and may contribute to the emergence of interest in children and adolescents in non-traditional forms of sexual behavior.” The court mentioned that “the page contains information that [the defendant] is a person of non-traditional sexual orientation, that is, a transsexual.” The defendant explained that she identifies as a woman and provides sex services only to men, which “exludes non-traditionalism”.</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#dating_profile_006"/>
