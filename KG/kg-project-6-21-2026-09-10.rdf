    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_4b7bb7af">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b93">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">The TV channel “Vostok TV” was fined for “distributing among minors information about non-traditional sexual relations”, as the mass media reported. The exact content that constituted the violation is unknown; the court did not publish the decision text.</dataout:hasSnippet>
