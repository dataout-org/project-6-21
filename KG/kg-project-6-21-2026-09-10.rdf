        <schema:name xml:lang="ru">Должностное лицо ООО “Кинопоиск”</schema:name>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_733434bf">
