      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_ccd75d77">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b215">
            <schema:currency>RUB</schema:currency>
