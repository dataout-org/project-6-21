  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_3fff70fd">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_792c4f49"/>
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_932ba6d9">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77RS0004"/>
        <dataout:courtDocumentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-12-10</dataout:courtDocumentDate>
        <dataout:courtDocumentNumber>12-2087/2024</dataout:courtDocumentNumber>
