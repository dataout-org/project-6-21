  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_06378b0b">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_6d27199c"/>
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_e74d3e07">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77RS0026"/>
        <dataout:courtDocumentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-27</dataout:courtDocumentDate>
        <dataout:courtDocumentNumber>05-0770/2024</dataout:courtDocumentNumber>
        <dataout:sourceCategory rdf:resource="https://dataout.org/ontology#courtDocument"/>
        <dataout:uniqueCourtDocumentID>77RS0026-02-2024-001157-96</dataout:uniqueCourtDocumentID>
      </dataout:Source>
    </prov:wasDerivedFrom>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#1237700009700"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_b3700108"/>
    <dataout:hasSnippet xml:lang="en">The streaming service “Wink” was fined for distributing the South Korean TV series “The One and Only” (2021). The court found that the series, available with a 16+ rating, contained information “demonstrating non-traditional sexual relations and preferences through a recurring storyline involving emotional attachment between two women”. In court, an expert emphasised that the analysed material depicted “relations between persons of the same sex,” relying not only on dialogue but also on “the semantic load carried by dialogues and monologues,” as well as visual scenes where one heroine “places her hand on the hand of another under romantic music.” Screenshots shown to the court were said to depict the women “holding hands, preparing to kiss one another, and the negative reaction of one heroine’s mother who caught them at that moment,” leading the expert to conclude that the material conveyed “not heterosexual and not friendly relations between two persons of the same sex,” even though “sexual interaction itself was not presented.”</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#127008"/>
    <dataout:mentionedIn rdf:resource="https://dataout.org/rdf/data/project-6-21#mentioned_in_aff5451f"/>
    <dataout:monitoredIncidentYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dataout:monitoredIncidentYear>
    <dataout:monitoringRecordNumber>05-0770/2024</dataout:monitoringRecordNumber>
    <schema:addressRegion rdf:resource="https://dataout.org/rdf/reference/ru_regions#77"/>
    <schema:identifier>record_06378b0b</schema:identifier>
  </dataout:MonitoringRecord>
  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_0dfd46d0">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_97b9b543"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#official_0028"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_e86083e8"/>
    <dataout:hasSnippet xml:lang="en">The deputy general director of the company “M3” was fined for distributing two films on the company's streaming service “More.tv”, labelled “16+”: “Three Many Weddings” (Javier Ruiz Caldera, 2013) and “Blow Dry” (Paddy Breathnach, 2001). In both films, experts from Roskomnadzor, the Russian mass media regulator, found  scenes “demonstrating non-traditional sexual relations” among minors. In the first film, these scenes include the appearance of a transgender character and dialogs about transition (the exact time codes are 00:56:57-00:58:20, 00:58:21-00:58:52, 01:00:12-01:01:33, 01:01:34-01:02:10, 01:02:11-01:03:29, 01:04:14-01:04:22, 01:06:19-01:06:34, 01:10:32-01:11:00). In the second, there was one scene (01:21:47-01:21:57), in which “two characters of the same sex (female) kissing in a sexual context.”</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#17203"/>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#201765"/>
