    <dataout:concernsLegalArticle>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_part_8">
        <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Distributing information or carrying out public actions intended to promote “non-traditional sexual relations and/or preferences, sex change, or refusal to have children” among minors by a foreign national or stateless person via mass media or internet. Punishment: RUB 200K–400K fine with administrative expulsion from Russia, or detention for up to 15 days with subsequent expulsion.</schema:description>
        <schema:description xml:lang="ru">Распространение информации или совершение публичных действий, направленных на “пропаганду нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения”, среди несовершеннолетних иностранным гражданином или лицом без гражданства через СМИ или интернет. Наказание: штраф от 200 до 400 тыс. руб. с административным выдворением из России или арест до 15 суток с последующим выдворением.</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21"/>
        <schema:name xml:lang="en">Article 6.21 part 8</schema:name>
        <schema:name xml:lang="ru">Статья 6.21 часть 8</schema:name>
      </schema:Legislation>
    </dataout:concernsLegalArticle>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#individual_0022">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#individual"/>
        <schema:identifier>individual_0022</schema:identifier>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_detention_a9e9503f">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#detention"/>
        <dataout:penaltyValue>
