  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_cc4999b2">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_85cfbb23"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_3"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#individual_0095"/>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_43f84c41">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">A VKontakte user was fined for publishing a picture in 2016, which depicted “underage males kissing” with the caption “Like if you're tolerant of the younger generation”. As the judicial expert concluded, this image “contained psychological and linguistic signs of propaganda of non-traditional sexual relations (homosexualism), expressed in attracting interest and forming sexual attitudes towards non-traditional sexual relations.” The amount of the fine has been redacted from the court ruling. The same individual was fined by the same judge on the same day at least twice for pictures on VK (see also 5-0264/2025).</dataout:hasSnippet>
