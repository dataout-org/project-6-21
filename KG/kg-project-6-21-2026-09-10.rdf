    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#1025202841399">
        <rdf:type rdf:resource="https://schema.org/Organization"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#legalEntity"/>
        <schema:identifier>1025202841399</schema:identifier>
        <schema:legalName xml:lang="ru">ООО “Пароль НН”</schema:legalName>
      </dataout:Defendant>
