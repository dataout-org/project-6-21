  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_819c2bb0">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_75c236a2"/>
