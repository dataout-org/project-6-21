        <schema:affiliation rdf:resource="https://dataout.org/rdf/data/project-6-21#1087746888833"/>
        <schema:identifier>official_0024</schema:identifier>
        <schema:name xml:lang="en">General director of the bookshop “Falanster”</schema:name>
        <schema:name xml:lang="ru">Генеральный директор ООО “Фаланстер”</schema:name>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_cb998bd4"/>
    <dataout:hasSnippet xml:lang="en">The general director of the bookshop “Falanster” was fined for selling five titles: “More Happy Than Not” (Adam Silvera, 2015), “The Fruit of Knowledge” (Liv Strömquist, 2014), “The Miseducation of Cameron Post” (Emily Danforth, 2012), “Infernal Feminism” (Per Faxneld, 2022), “Fence, Vol. 2” (Pascat, 2018), “Everybody: A Book About Freedom” (Olivia Lang, 2021). The judicial expertise concluded that these books “contained psychological and linguistic signs of propaganda of non-traditional sexual relations and/or preferences and/or sex change, and also contain incentives to engage in LGBT relationships.” The legal entity of the bookshop was also fined for the same books by the same judge on the same day (see case 05-0268/2025).</dataout:hasSnippet>
