  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_c13a3ebb">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_c9fc87bc">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#67OS0000"/>
