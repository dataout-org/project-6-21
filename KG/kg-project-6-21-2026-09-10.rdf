  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_3454df9a">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_c18b7393"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_part_5">
        <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Distributing information or carrying out public actions intended to promote “non-traditional sexual relations and/or preferences, sex change, or refusal to have children” by a foreign national or stateless person. Punishment: RUB 50K–100K fine with administrative expulsion from Russia, or detention for up to 15 days with subsequent expulsion.</schema:description>
        <schema:description xml:lang="ru">Распространение информации или совершение публичных действий, направленных на “пропаганду нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения”, иностранным гражданином или лицом без гражданства. Наказание: штраф от 50 до 100 тыс. руб. с административным выдворением из России или арест до 15 суток с последующим выдворением.</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21"/>
        <schema:name xml:lang="en">Article 6.21 part 5</schema:name>
        <schema:name xml:lang="ru">Статья 6.21 часть 5</schema:name>
      </schema:Legislation>
    </dataout:concernsLegalArticle>
