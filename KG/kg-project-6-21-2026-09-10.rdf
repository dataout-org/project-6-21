        <dataout:uniqueCourtDocumentID>77RS0026-02-2024-004902-16</dataout:uniqueCourtDocumentID>
      </dataout:Source>
    </prov:wasDerivedFrom>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#1077759854919"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_133d88ab"/>
    <dataout:hasSnippet xml:lang="en">The streaming service “Kinopoisk” was fined for distributing a series among minors, which, according to the court, contained scenes of “non-traditional sexual relations”. The court redacted the title of the series in the decision text. The judicial experts analysed the scene of the third episode of the series (48:52-49:05), which “contains a kiss between two individuals presented as persons of the same biological sex (female).” Their analysis was based on the “classification of kisses, which divides them into social and sensual, the latter differing depending on the types of feelings that lie behind the kissing signs (kisses of affection, kisses of tenderness, kisses of respect and kisses of love).” However, it is not specified how exactly the experts classified the kissing scene.</dataout:hasSnippet>
