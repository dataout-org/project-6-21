    <dataout:concernsLegalArticle>
      <schema:Legislation rdf:about="https://dataout.org/rdf/reference/ru_law#article_6_21_part_2">
        <rdfs:comment xml:lang="en">The content of the article is shortened by us for clarity and brevity. The translated quotations contain stigmatising language.</rdfs:comment>
        <rdfs:comment xml:lang="ru">Мы сократили формулировки статьи для ясности. Цитаты из оригинальной статьи содержат уничижительные выражения.</rdfs:comment>
        <schema:description xml:lang="en">Distributing information or carrying out public actions intended to promote “non-traditional sexual relations and/or preferences, sex change, or refusal to have children” among minors. Individuals may be fined RUB 100K–200K; officials RUB 200K–400K; and legal entities RUB 1M–2M, or have their activities suspended for up to 90 days.</schema:description>
        <schema:description xml:lang="ru">Распространение информации или совершение публичных действий, направленных на “пропаганду нетрадиционных сексуальных отношений и (или) предпочтений, смены пола, отказа от деторождения” среди несовершеннолетних. Наказание: штраф от 100 до 200 тыс. руб. для физических лиц, для должностных — от 200 до 400 тыс. руб., для юридических — от 1 до 2 млн. руб. или административное приостановление деятельности до 90 суток.</schema:description>
        <schema:isPartOf rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21"/>
        <schema:name xml:lang="en">Article 6.21 part 2</schema:name>
        <schema:name xml:lang="ru">Статья 6.21 часть 2</schema:name>
      </schema:Legislation>
    </dataout:concernsLegalArticle>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#individual_0013">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#individual"/>
        <schema:identifier>individual_0013</schema:identifier>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_6762fc28">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b121">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">A VKontakte user was fined for posting “We invite you to sign up for Irkutsk LGBT Chat group. We're looking for active kids. Ages 14+ [...]”, which the court found to be “promotion of non-traditional sexual relations” among minors.</dataout:hasSnippet>
