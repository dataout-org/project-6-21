    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#individual_0050">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#individual"/>
        <schema:identifier>individual_0050</schema:identifier>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_36f267ec"/>
    <dataout:hasSnippet xml:lang="en">An individual was fined for posting a meme on VKontakte, which depicted a drawing of Quentin Tarantino with a quote attributed to him, “Making movies and not children is my motto”. In court, the defendant explained that she had uploaded the image in 2021 because she liked Tarantino and, at that time, associated the quotation with prioritising work over family rather than rejecting parenthood. She also stated that she had lost access to the account in 2022 and could not delete the post. This ruling has been reported as the first known fine imposed under Russia’s ban on the so-called “childfree propaganda,” introduced by the November 2024 amendments to Article 6.21.</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#social_media_060"/>
