  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_6679c2c9">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_34b621e5"/>
