  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_efc30f6c">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_b1dee009">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77MS0466"/>
