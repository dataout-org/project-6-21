    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_670c39a8">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b118">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">A youth organisation was fined for screening the film “The Whale” (Darren Arranofski, 2022) during a movie night organised for adolescents. A judicial expert determined that this film “creates a distorted impression of the equivalence of traditional and non-traditional sexual relations.” According to the expert, “the theme of non-traditional sexual relations is not emphasised in this film; its main plot does not include love scenes, kisses, or attempts at physical seduction. However, this theme is presented as an important plot element.” The description of the exact scenes was redacted in the court decision.</dataout:hasSnippet>
