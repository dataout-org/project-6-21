  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_4e0b6613">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_3053fdfe"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_3"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#individual_0064"/>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_32eede55">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">A VKontakte user was fined for publishing “an image of two men kissing with the text 'It could have been you and me, but you didn't go to PE'.” The judicial experts concluded that the image “contained linguistic and psychological signs of propaganda for non-traditional sexual relations [...] expressed in the presentation of love and sexual scenes between two men in an aesthetically pleasing manner with the aim of arousing interest in such contacts, i.e., in demonstrating and attracting the viewer's attention to non-traditional (same-sex) relationships.” The exact images are unclear; the profile has been deleted. This individual was fined at least three times by the same judge on the same day for posting on VKontakte and was also detained for 15 days for posting images depicting rainbow flags, which the court deemed as “public demonstration of extremist symbols” (article 20.3).</dataout:hasSnippet>
