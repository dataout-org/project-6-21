  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_5d903167">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_86139037"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_2"/>
    <dataout:hasDefendant>
      <dataout:Defendant rdf:about="https://dataout.org/rdf/data/project-6-21#official_0001">
        <rdf:type rdf:resource="https://schema.org/Person"/>
        <dataout:defendantCategory rdf:resource="https://dataout.org/ontology#official"/>
        <schema:identifier>official_0001</schema:identifier>
        <schema:name xml:lang="en">Editor-in-chief of “CRNews”</schema:name>
        <schema:name xml:lang="ru">Главный редактор “CRNews”</schema:name>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_9c573f39"/>
    <dataout:hasSnippet xml:lang="en">The editor-in-chief of the Kursk online media outlet “CRNews” was fined for publishing the article "You and I won't make it" (09.08.2013), which, according to the court, “contained information aimed at developing non-traditional sexual attitudes in minors.” A judicial expert determined that the article contained “a sufficient number of suggestive techniques to [...] influence the psyche of children in terms of the presence of propaganda of homosexualism.” The expert classified phrases from the article as: “direct suggestive commands” ('Why don't you try becoming a lesbian'); “truismes” ('There aren't many joys in the life of gays'); “programming homosexual behavior” ('I can become a good mother'); “phrases appealing to presubposition” ('you know that gays earn more'); “use of manipulative figures of speech” (the expert wrote that the sentence 'After all, the male body with which God mistakenly endowed me is more resilient' “contains the false premise that God can make mistakes”); “analogous phrases with a false premise” ('Two dads? What a shame. But what about a mother, a grandmother, an aunt – is that a normal family?!'). The article is no longer available online.</dataout:hasSnippet>
