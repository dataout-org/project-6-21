    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_15c238fc">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b33">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">The streaming service “Kinopoisk” was fined for the film “Love” (Gaspar Noé, 2015). The judge stated that the “the propaganda of non-traditional sexual relations in the feature film is expressed through the formation of a positive image of people in non-traditional sexual relations.” The exact scenes that constituted the violation are not specified.</dataout:hasSnippet>
