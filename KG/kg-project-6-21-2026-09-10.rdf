        <schema:name xml:lang="ru">Главный редактор “7×7 — Горизонтальная Россия”</schema:name>
      </dataout:Defendant>
    </dataout:hasDefendant>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_82c0f497">
