    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_aab5a9dc">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b189">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">The publishing house “Ad Marginem” was fined for distributing six books: “More Happy Than Not” (Adam Silvera, 2015), “The Fruit of Knowledge” (Liv Strömquist, 2014), “The Miseducation of Cameron Post” (Emily Danforth, 2012), “Infernal Feminism” (Per Faxneld, 2022), “Fence, Vol. 2” (Pascat, 2018), and “Everybody: A Book About Freedom” (Olivia Lang, 2021). According to the court, these books “contained psychological and linguistic elements of propaganda for non-traditional sexual relations and/or preferences and/or sex change and also contained incitement to LGBTQ+ relationships”. The court mentioned that these books were sold at the “Falanster” bookshop, which was also fined for distributing the same titles (see case 05-0268/2025).</dataout:hasSnippet>
