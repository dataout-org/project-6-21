  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_f1332b9f">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_4d805313">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77RS0026"/>
        <dataout:courtDocumentDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-08</dataout:courtDocumentDate>
