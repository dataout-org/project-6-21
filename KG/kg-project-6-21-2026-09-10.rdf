  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_53f9a976">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_25932cda">
        <dcterms:creator rdf:resource="https://dataout.org/rdf/reference/ru_courts#77MS0374"/>
