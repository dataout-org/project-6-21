  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_3228cdf2">
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_32360c37"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_part_3"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#1077759854919"/>
    <dataout:hasPenalty rdf:resource="https://dataout.org/rdf/data/project-6-21#pen_fine_784acc8d"/>
    <dataout:hasSnippet xml:lang="en">The streaming service “Kinopoisk” was fined for the film “Yves Saint Laurent” (Jalil Lespert, 2014), which, according to the court, “contained information promoting non-traditional sexual relations and (or) preferences.” One judicial expert from Roskomnadzor, the Russian mass media regulator, stated that “scenes of non-traditional sexual relations are shown throughout the film, which meets the criteria of propaganda.” Another expert identified another “propaganda technique” in the film, which was “the formation of the image of a victim subjected to aggression from people of heterosexual orientation.”</dataout:hasSnippet>
    <dataout:hasTriggerObject rdf:resource="https://dataout.org/rdf/data/project-6-21#245775"/>
