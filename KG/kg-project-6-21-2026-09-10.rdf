  <dataout:MonitoringRecord rdf:about="https://dataout.org/rdf/data/project-6-21#record_867c80a6">
    <prov:wasDerivedFrom>
      <dataout:Source rdf:about="https://dataout.org/rdf/data/project-6-21#source_9e1b507e">
        <dcterms:creator xml:lang="en">Forbes.ru</dcterms:creator>
        <dcterms:creator xml:lang="ru">Forbes.ru</dcterms:creator>
        <dataout:sourceCategory rdf:resource="https://dataout.org/ontology#massMediaPublication"/>
        <schema:archivedAt rdf:resource="https://web.archive.org/web/20260606212812/https://www.forbes.ru/society/493891-gendirektora-andeksa-ostrafovali-za-pokaz-na-kinopoiske-fil-mov-s-lgbt?ysclid=mko5pxwvev594390843#"/>
      </dataout:Source>
    </prov:wasDerivedFrom>
    <prov:wasDerivedFrom rdf:resource="https://dataout.org/rdf/data/project-6-21#source_e64a6933"/>
    <prov:wasGeneratedBy rdf:resource="https://dataout.org/rdf/data/project-6-21#MonitoringDec2025"/>
    <dataout:concernsLegalArticle rdf:resource="https://dataout.org/rdf/reference/ru_law#article_6_21_2_part_2"/>
    <dataout:hasDefendant rdf:resource="https://dataout.org/rdf/data/project-6-21#official_0021"/>
    <dataout:hasPenalty>
      <dataout:Penalty rdf:about="https://dataout.org/rdf/data/project-6-21#pen_fine_d4df9da7">
        <dataout:penaltyCategory rdf:resource="https://dataout.org/ontology#fine"/>
        <dataout:penaltyValue>
          <schema:MonetaryAmount rdf:nodeID="nb339817b2c8941f983f86810fb398ca2b223">
            <schema:currency>RUB</schema:currency>
            <schema:value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200000</schema:value>
          </schema:MonetaryAmount>
        </dataout:penaltyValue>
      </dataout:Penalty>
    </dataout:hasPenalty>
    <dataout:hasSnippet xml:lang="en">The “Yandex” CEO Artem Savinovsky was fined for distributing ten films on the company's streaming service “Kinopoisk”: “Perfect Strangers” (Paolo Genovese, 2016), “Bridget Jones: The Edge of Reason” (Beeban Kidron, 2004), “Three Many Weddings” (Javier Ruiz Caldera, 2013), “Easy A” (Will Gluck, 2010), “Blow Dry” (Paddy Breathnach, 2001), “Compartment No. 6” (Juho Kuosmanen, 2021), “Greed” (Michael Winterbottom, 2019), “Green Book” (Peter Farrelly, 2018), “The Amusement Park” (the title translated from Russian, the exact film is unknown), and “Beanpole” (Kantemir Balagov, 2019). According to the court, these films “demonstrated non-traditional sexual relations and/or preferences” and should have been marked “18+” instead of “16+”. The court did not specify the exact scenes in these movies that constituted the violation. The company which owns the streaming service was fined earlier for the same titles (see case 05-1459/2023). This CEO was previously fined by the same court for four other titles (case 5-1020/23). </dataout:hasSnippet>
